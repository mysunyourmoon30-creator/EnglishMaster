{
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "DevelopmentSeed": {
    "Enabled": true
  },
  "Auth": {
    "AllowInsecureLoopbackCookies": false
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "SeedGrammarCurriculum": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
