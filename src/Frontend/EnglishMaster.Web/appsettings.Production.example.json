{
  "ApiBaseUrl": "https://api.example.com/",
  "Auth": {
    "AllowInsecureLoopbackCookies": false
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "KnownProxy": "<reverse-proxy-ip>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "<web-host>"
}
