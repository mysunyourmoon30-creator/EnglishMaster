<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="@(string.IsNullOrEmpty(Title) ? "true" : "false")"
     role="@(string.IsNullOrEmpty(Title) ? null : "img")">
    @if (!string.IsNullOrEmpty(Title))
    {
        <title>@Title</title>
    }
    @GetShape(Name)
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter]
    public int Size { get; set; } = 18;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Title { get; set; }

    private static MarkupString GetShape(string name) => name switch
    {
        "menu" => Raw("<line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"/><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"/><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"/>"),
        "chevron-down" => Raw("<polyline points=\"6 9 12 15 18 9\"/>"),
        "chevron-right" => Raw("<polyline points=\"9 6 15 12 9 18\"/>"),
        "chevron-left" => Raw("<polyline points=\"15 6 9 12 15 18\"/>"),
        "chevron-up" => Raw("<polyline points=\"6 15 12 9 18 15\"/>"),
        "dashboard" => Raw("<rect x=\"3\" y=\"3\" width=\"8\" height=\"8\" rx=\"1.5\"/><rect x=\"13\" y=\"3\" width=\"8\" height=\"5\" rx=\"1.5\"/><rect x=\"13\" y=\"10\" width=\"8\" height=\"11\" rx=\"1.5\"/><rect x=\"3\" y=\"13\" width=\"8\" height=\"8\" rx=\"1.5\"/>"),
        "search" => Raw("<circle cx=\"11\" cy=\"11\" r=\"7\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/>"),
        "word" => Raw("<line x1=\"4\" y1=\"6\" x2=\"20\" y2=\"6\"/><line x1=\"4\" y1=\"12\" x2=\"16\" y2=\"12\"/><line x1=\"4\" y1=\"18\" x2=\"12\" y2=\"18\"/>"),
        "category" => Raw("<path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z\"/>"),
        "tag" => Raw("<path d=\"M2 12 12 2h8v8L10 20a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8Z\"/><circle cx=\"15.5\" cy=\"6.5\" r=\"1.4\" fill=\"currentColor\" stroke=\"none\"/>"),
        "media" => Raw("<rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><circle cx=\"9\" cy=\"10\" r=\"2\"/><path d=\"m3 17 5-5 4 4 3-3 6 6\"/>"),
        "pronunciation" => Raw("<path d=\"M4 9v6h4l5 5V4L8 9H4Z\"/><path d=\"M17 8a5 5 0 0 1 0 8\"/><path d=\"M20 5a9 9 0 0 1 0 14\"/>"),
        "grammar" => Raw("<path d=\"M3 5c3-1.2 6-1.2 9 0v14c-3-1.2-6-1.2-9 0V5Z\"/><path d=\"M21 5c-3-1.2-6-1.2-9 0v14c3-1.2 6-1.2 9 0V5Z\"/>"),
        "lesson" => Raw("<path d=\"M2 9 12 4l10 5-10 5-10-5Z\"/><path d=\"M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5\"/>"),
        "course" => Raw("<path d=\"M12 3 2 8l10 5 10-5-10-5Z\"/><path d=\"m2 13 10 5 10-5\"/><path d=\"m2 17 10 5 10-5\"/>"),
        "book" => Raw("<path d=\"M4 4.5A2.5 2.5 0 0 1 6.5 2H20v18H6.5A2.5 2.5 0 0 0 4 22.5v-18Z\"/><line x1=\"4\" y1=\"19.5\" x2=\"20\" y2=\"19.5\"/>"),
        "quiz" => Raw("<rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><polyline points=\"8 12 11 15 16 9\"/>"),
        "certificate" => Raw("<circle cx=\"12\" cy=\"8\" r=\"6\"/><path d=\"m9 13.5-2 7 5-3 5 3-2-7\"/>"),
        "report" => Raw("<line x1=\"4\" y1=\"20\" x2=\"20\" y2=\"20\"/><rect x=\"6\" y=\"12\" width=\"3\" height=\"8\"/><rect x=\"11\" y=\"7\" width=\"3\" height=\"13\"/><rect x=\"16\" y=\"3\" width=\"3\" height=\"17\"/>"),
        "analytics" => Raw("<polyline points=\"3 17 9 11 13 15 21 6\"/><polyline points=\"15 6 21 6 21 12\"/>"),
        "health" => Raw("<polyline points=\"3 12 8 12 10 6 14 18 16 12 21 12\"/>"),
        "bell" => Raw("<path d=\"M6 9a6 6 0 0 1 12 0c0 5 2 6 2 6H4s2-1 2-6Z\"/><path d=\"M10 20a2 2 0 0 0 4 0\"/>"),
        "mail" => Raw("<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><polyline points=\"3 7 12 13 21 7\"/>"),
        "users" => Raw("<circle cx=\"9\" cy=\"8\" r=\"3.2\"/><path d=\"M3.5 20c0-3.5 2.5-5.5 5.5-5.5s5.5 2 5.5 5.5\"/><circle cx=\"17\" cy=\"9\" r=\"2.6\"/><path d=\"M20.5 20c0-2.8-1.6-4.6-3.8-5.1\"/>"),
        "shield" => Raw("<path d=\"M12 3 5 6v6c0 5 3 8 7 9 4-1 7-4 7-9V6l-7-3Z\"/>"),
        "quality" => Raw("<circle cx=\"12\" cy=\"12\" r=\"9\"/><polyline points=\"8 12.5 11 15.5 16 9\"/>"),
        "revision" => Raw("<path d=\"M3 12a9 9 0 1 0 3-6.7\"/><polyline points=\"3 4 3 9 8 9\"/><polyline points=\"12 7 12 12 16 14\"/>"),
        "bulk-ops" => Raw("<line x1=\"8\" y1=\"6\" x2=\"21\" y2=\"6\"/><line x1=\"8\" y1=\"12\" x2=\"21\" y2=\"12\"/><line x1=\"8\" y1=\"18\" x2=\"21\" y2=\"18\"/><circle cx=\"3.5\" cy=\"6\" r=\"1\" fill=\"currentColor\" stroke=\"none\"/><circle cx=\"3.5\" cy=\"12\" r=\"1\" fill=\"currentColor\" stroke=\"none\"/><circle cx=\"3.5\" cy=\"18\" r=\"1\" fill=\"currentColor\" stroke=\"none\"/>"),
        "import" => Raw("<path d=\"M12 3v12\"/><polyline points=\"7 10 12 15 17 10\"/><path d=\"M5 19h14\"/>"),
        "export" => Raw("<path d=\"M12 21V9\"/><polyline points=\"7 14 12 9 17 14\"/><path d=\"M5 19h14\"/>"),
        "publish" => Raw("<path d=\"m3 11 18-8-8 18-2-8-8-2Z\"/>"),
        "logout" => Raw("<path d=\"M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4\"/><polyline points=\"16 17 21 12 16 7\"/><line x1=\"21\" y1=\"12\" x2=\"9\" y2=\"12\"/>"),
        "plus" => Raw("<line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"/><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/>"),
        "eye" => Raw("<path d=\"M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/>"),
        "edit" => Raw("<path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z\"/>"),
        "trash" => Raw("<polyline points=\"3 6 5 6 21 6\"/><path d=\"M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"/><path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6\"/><line x1=\"10\" y1=\"11\" x2=\"10\" y2=\"17\"/><line x1=\"14\" y1=\"11\" x2=\"14\" y2=\"17\"/>"),
        _ => Raw("<circle cx=\"12\" cy=\"12\" r=\"9\"/>")
    };

    private static MarkupString Raw(string svg) => new(svg);
}
