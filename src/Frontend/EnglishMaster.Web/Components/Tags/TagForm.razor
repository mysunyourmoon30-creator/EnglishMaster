<EditForm Model="Model" OnValidSubmit="SubmitAsync" class="word-form">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (ValidationErrors.Count > 0)
    {
        <div class="alert error">
            <ul>
                @foreach (var error in ValidationErrors.SelectMany(item => item.Value))
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <h3 class="detail-section-heading">Identity / ข้อมูลหลัก</h3>
    <div class="form-grid">
        <label>
            <span>Name / ชื่อป้ายกำกับ</span>
            <InputText class="input" placeholder="Common Rank 1-500 or A1 / เช่น Common Rank 1-500 หรือ A1" @bind-Value="Model.Name" />
            <ValidationMessage For="@(() => Model.Name)" />
        </label>

        @if (ShowActiveToggle)
        {
            <label class="checkbox-row">
                <InputCheckbox @bind-Value="Model.IsActive" />
                <span>Active / ใช้งาน</span>
            </label>
        }
    </div>

    <h3 class="detail-section-heading">Details / รายละเอียด</h3>
    <div class="form-grid">
        <label class="span-2">
            <span>Description / คำอธิบาย</span>
            <InputTextArea class="input textarea" placeholder="Explain which words this tag groups, or which learner level it supports. / อธิบายว่าป้ายนี้ใช้กับคำกลุ่มไหน หรือเหมาะกับผู้เรียนระดับใด" @bind-Value="Model.Description" />
            <ValidationMessage For="@(() => Model.Description)" />
        </label>
    </div>

    <div class="actions">
        <button class="button primary" type="submit" disabled="@IsSaving">@SubmitText</button>
        <a class="button" href="@AdminRoutes.Tags.Index">Cancel / ยกเลิก</a>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public TagFormModel Model { get; set; } = new();

    [Parameter]
    public IReadOnlyDictionary<string, string[]> ValidationErrors { get; set; } =
        new Dictionary<string, string[]>();

    [Parameter]
    public bool IsSaving { get; set; }

    [Parameter]
    public bool ShowActiveToggle { get; set; }

    [Parameter]
    public string SubmitText { get; set; } = "Save";

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    private async Task SubmitAsync()
    {
        await OnValidSubmit.InvokeAsync();
    }
}
