@page "/admin/media"
@rendermode InteractiveServer
@inject IMediaApiClient MediaApiClient

<PageTitle>Media</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">ASSETS / สื่อประกอบ</p>
        <h1>Media</h1>
        <p class="page-subtitle">Manage images, audio, and files used by words, pronunciation, lessons, books, and quizzes. / จัดการรูปภาพ เสียง และไฟล์ที่ใช้กับคำศัพท์ การออกเสียง บทเรียน หนังสือ และแบบฝึก</p>
    </div>
    <div class="actions">
        <a class="button" href="@AdminRoutes.Media.Upload"><Icon Name="plus" Size="16" /> Upload / อัปโหลด</a>
        <a class="button primary" href="@AdminRoutes.Media.Create"><Icon Name="plus" Size="16" /> New Media / เพิ่มสื่อ</a>
    </div>
</section>

<section class="panel release-note">
    <div>
        <strong>Accessibility check / ตรวจการใช้งานสำหรับทุกคน</strong>
        <p class="muted">Images should have helpful alt text. Audio should have a clear description so admins know where it belongs.</p>
        <p class="muted">รูปภาพควรมี alt text ที่เข้าใจง่าย ส่วนไฟล์เสียงควรมีคำอธิบายว่าถูกใช้กับคำหรือบทเรียนใด</p>
    </div>
</section>

<section class="panel">
    <form class="filters-grid" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label>
            <span>Search / ค้นหา</span>
            <input class="input" @bind="search" @bind:event="oninput" />
        </label>
        <label>
            <span>Media Type / ประเภทสื่อ</span>
            <select class="input" @bind="mediaType">
                <option value="">All types / ทุกประเภท</option>
                @foreach (var option in MediaTypeOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </label>
        <label>
            <span>Content Type / ชนิดไฟล์</span>
            <input class="input" @bind="contentType" @bind:event="oninput" />
        </label>
        <label>
            <span>Status / สถานะ</span>
            <select class="input" @bind="activeFilter">
                <option value="true">Active / ใช้งาน</option>
                <option value="false">Inactive / ปิด</option>
                <option value="">All / ทั้งหมด</option>
            </select>
        </label>
        <label>
            <span>Page Size / จำนวนต่อหน้า</span>
            <select class="input" @bind="pageSize">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </label>
        <button class="button" type="submit">Search / ค้นหา</button>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}

@if (isLoading)
{
    <p class="muted">Loading media... / กำลังโหลดสื่อ</p>
}
else if (mediaItems.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="media" Size="22" /></span>
        <strong>No media found / ยังไม่พบสื่อ</strong>
        <p>Try adjusting filters or upload the first asset. / ลองเปลี่ยนตัวกรอง หรืออัปโหลดสื่อแรก</p>
        <div class="actions">
            <a class="button primary" href="@AdminRoutes.Media.Upload"><Icon Name="plus" Size="16" /> Upload Media / อัปโหลดสื่อ</a>
        </div>
    </section>
}
else
{
    <section class="table-wrap">
        <div class="pagination-summary">
            <span class="muted">Page @searchResult.PageNumber of @searchResult.TotalPages / หน้า @searchResult.PageNumber จาก @searchResult.TotalPages</span>
            <span class="status-badge neutral">@searchResult.TotalCount media items / @searchResult.TotalCount รายการ</span>
        </div>
        <div class="card-grid">
            @foreach (var media in mediaItems)
            {
                <div class="entity-card">
                    <a class="entity-card-link" href="@AdminRoutes.Media.Detail(media.Id)">
                        <div class="entity-card-media">
                            @if (media.MediaType == "Image" && !string.IsNullOrWhiteSpace(media.PublicUrl))
                            {
                                <img src="@media.PublicUrl" alt="@media.AltText" />
                            }
                            else
                            {
                                <Icon Name="media" Size="28" />
                            }
                        </div>
                        <div class="entity-card-body">
                            <h3>@media.OriginalFileName</h3>
                            <span class="muted">@media.MediaType &middot; @FormatSize(media.FileSize)</span>
                        </div>
                    </a>
                    <div class="entity-card-footer">
                        <span class="status-badge @(media.IsActive ? "success" : "muted")">@(media.IsActive ? "Active / ใช้งาน" : "Inactive / ปิด")</span>
                        <span class="row-actions">
                            <a class="button small" href="@AdminRoutes.Media.Detail(media.Id)" aria-label="View @media.OriginalFileName" title="View"><Icon Name="eye" Size="15" /></a>
                            <a class="button small" href="@AdminRoutes.Media.Edit(media.Id)" aria-label="Edit @media.OriginalFileName" title="Edit"><Icon Name="edit" Size="15" /></a>
                            <button class="button small danger" type="button" @onclick="() => DeleteAsync(media.Id)" aria-label="Delete @media.OriginalFileName" title="Delete"><Icon Name="trash" Size="15" /></button>
                        </span>
                    </div>
                </div>
            }
        </div>
        <div class="pagination-row">
            <button class="button small" type="button" disabled="@(!searchResult.HasPreviousPage)" @onclick="PreviousPageAsync">Previous / ก่อนหน้า</button>
            <span class="muted">Page @searchResult.PageNumber / หน้า @searchResult.PageNumber</span>
            <button class="button small" type="button" disabled="@(!searchResult.HasNextPage)" @onclick="NextPageAsync">Next / ถัดไป</button>
        </div>
    </section>
}

@code {
    private static readonly string[] MediaTypeOptions = ["Image", "Audio", "Video", "Document", "Other"];

    private IReadOnlyCollection<MediaDto> mediaItems = [];
    private MediaSearchResponse searchResult = EmptySearchResult();
    private string? search;
    private string? mediaType;
    private string? contentType;
    private string activeFilter = "true";
    private int pageNumber = 1;
    private int pageSize = 10;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            searchResult = await MediaApiClient.SearchAsync(
                new MediaSearchRequest(
                    search,
                    string.IsNullOrWhiteSpace(mediaType) ? null : mediaType,
                    string.IsNullOrWhiteSpace(contentType) ? null : contentType,
                    ParseActiveFilter(),
                    pageNumber,
                    pageSize),
                CancellationToken.None);
            mediaItems = searchResult.Items;
        }
        catch (ApiRequestException exception)
        {
            searchResult = EmptySearchResult();
            mediaItems = [];
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (!searchResult.HasPreviousPage)
        {
            return;
        }

        pageNumber--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (!searchResult.HasNextPage)
        {
            return;
        }

        pageNumber++;
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        errorMessage = null;

        try
        {
            await MediaApiClient.DeleteAsync(id, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
    }

    private bool? ParseActiveFilter()
    {
        return activeFilter switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
    }

    private static MediaSearchResponse EmptySearchResult()
    {
        return new MediaSearchResponse([], 1, 10, 0, 0, false, false);
    }

    private static string FormatSize(long bytes)
    {
        return bytes < 1024
            ? $"{bytes} B"
            : $"{bytes / 1024d:0.##} KB";
    }
}
