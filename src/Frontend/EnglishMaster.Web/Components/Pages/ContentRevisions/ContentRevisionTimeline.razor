@page "/admin/content-revisions/{ContentType}/{ContentId:guid}"
@rendermode InteractiveServer
@inject IContentRevisionApiClient ContentRevisionApiClient

<PageTitle>Revision Timeline</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>Revision Timeline</h1>
        <p class="page-subtitle">Chronological history of revisions for @ContentType @ContentId.</p>
    </div>
    <div class="actions">
        <a class="button" href="@AdminRoutes.ContentRevisions.Index">Back</a>
    </div>
</section>

@if (isLoading)
{
    <p class="muted">Loading timeline...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (revisions.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="revision" Size="22" /></span>
        <strong>No revisions found</strong>
        <p>This content item has no recorded revision history yet.</p>
    </section>
}
else
{
    <section class="panel">
        <div class="timeline">
            @foreach (var revision in revisions)
            {
                <div class="timeline-item">
                    <div class="timeline-item-title">#@revision.RevisionNumber @revision.EventType</div>
                    <p class="muted">@revision.ChangedBy · @revision.ChangedAt.LocalDateTime.ToString("g", CultureInfo.InvariantCulture)</p>
                    <a class="button small" href="@AdminRoutes.ContentRevisions.Detail(revision.Id)" aria-label="View revision #@revision.RevisionNumber" title="View"><Icon Name="eye" Size="15" /></a>
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter] public string ContentType { get; set; } = string.Empty;
    [Parameter] public Guid ContentId { get; set; }
    private IReadOnlyCollection<ContentRevisionDto> revisions = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            revisions = (await ContentRevisionApiClient.GetRevisionsForContentAsync(ContentType, ContentId, CancellationToken.None)).Items;
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
