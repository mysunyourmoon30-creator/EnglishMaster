@page "/admin/content-revision-restores"
@rendermode InteractiveServer
@inject IContentRevisionApiClient ContentRevisionApiClient

<PageTitle>Revision Restores</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>Revision Restore Requests</h1>
        <p class="page-subtitle">Review and action requests to restore content to a prior revision.</p>
    </div>
    <div class="actions">
        <a class="button" href="@AdminRoutes.ContentRevisions.Index">Back to Revisions</a>
    </div>
</section>

@if (isLoading)
{
    <p class="muted">Loading restore requests...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (requests.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="revision" Size="22" /></span>
        <strong>No restore requests found</strong>
        <p>Restore requests appear here once someone asks to revert content to an earlier revision.</p>
    </section>
}
else
{
    <section class="content-list">
        @foreach (var request in requests)
        {
            <article class="panel">
                <div class="item-header">
                    <div>
                        <h2><Icon Name="revision" Size="17" /> @request.Status</h2>
                        <p class="muted">@request.RequestedBy at @request.RequestedAt.LocalDateTime.ToString("g", CultureInfo.InvariantCulture)</p>
                    </div>
                    <a class="button small" href="@AdminRoutes.ContentRevisions.RestoreDetail(request.Id)" aria-label="View restore request" title="View"><Icon Name="eye" Size="15" /></a>
                </div>
                <p>@request.Reason</p>
            </article>
        }
    </section>
}

@code {
    private IReadOnlyCollection<ContentRevisionRestoreRequestDto> requests = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            requests = (await ContentRevisionApiClient.SearchRestoreRequestsAsync(null, CancellationToken.None)).Items;
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
