@page "/admin/content-revisions/{Id:guid}"
@rendermode InteractiveServer
@inject IContentRevisionApiClient ContentRevisionApiClient

<PageTitle>Content Revision</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>Content Revision</h1>
        <p class="page-subtitle">Details and snapshot for a single content revision.</p>
    </div>
    <div class="actions">
        <a class="button" href="@AdminRoutes.ContentRevisions.Index">Back</a>
    </div>
</section>

@if (isLoading)
{
    <LoadingIndicator Text="Loading revision..." />
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (revision is not null)
{
    <section class="panel">
        <h3 class="detail-section-heading">Overview</h3>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="muted">Content Type</span>
                <strong>@revision.ContentType #@revision.RevisionNumber</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Event Type</span>
                <strong>@revision.EventType</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Changed By</span>
                <strong>@revision.ChangedBy</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Changed At</span>
                <strong>@revision.ChangedAt.LocalDateTime.ToString("g", CultureInfo.InvariantCulture)</strong>
            </div>
            <div class="detail-item full">
                <span class="muted">Change Reason</span>
                <strong>@revision.ChangeReason</strong>
            </div>
        </div>

        <h3 class="detail-section-heading">Snapshot</h3>
        <pre>@revision.SnapshotJson</pre>
    </section>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private ContentRevisionDto? revision;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            revision = await ContentRevisionApiClient.GetRevisionAsync(Id, CancellationToken.None);
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
