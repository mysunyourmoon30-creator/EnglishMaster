@page "/admin/grammar-rules/{Id:guid}"
@rendermode InteractiveServer
@inject IGrammarApiClient GrammarApiClient
@inject IWordsApiClient WordsApiClient

<PageTitle>@(rule is null ? "Grammar Rule" : rule.Title)</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">GRAMMAR RULE / กฎไวยากรณ์</p>
        <h1>@(rule is null ? "Grammar Rule" : rule.Title)</h1>
        @if (rule is not null)
        {
            <p class="page-subtitle">Check the rule, structure, examples, common mistakes, and related words. / ตรวจเนื้อหากฎ โครงสร้าง ตัวอย่าง จุดที่มักผิด และคำศัพท์ที่เกี่ยวข้อง</p>
        }
    </div>
    <div class="actions">
        <a class="button" href="@AdminRoutes.GrammarRules.Index">Back / กลับ</a>
        @if (rule is not null)
        {
            <a class="button" href="@AdminRoutes.GrammarTopics.Detail(rule.GrammarTopicId)"><Icon Name="grammar" Size="15" /> Topic / หัวข้อ</a>
            <a class="button primary" href="@AdminRoutes.GrammarRules.Edit(rule.Id)"><Icon Name="edit" Size="15" /> Edit / แก้ไข</a>
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}

@if (isLoading)
{
    <p class="muted">Loading grammar rule... / กำลังโหลดกฎไวยากรณ์</p>
}
else if (notFound)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="grammar" Size="22" /></span>
        <strong>Grammar rule was not found / ไม่พบกฎไวยากรณ์</strong>
        <p>It may have been deleted or the link is incorrect. / อาจถูกลบแล้ว หรือลิงก์ไม่ถูกต้อง</p>
        <div class="actions">
            <a class="button" href="@AdminRoutes.GrammarRules.Index">Back to Grammar Rules / กลับรายการกฎ</a>
        </div>
    </section>
}
else if (rule is not null)
{
    <section class="panel release-note">
        <div>
            <strong>Teaching readiness / ความพร้อมสำหรับสอน</strong>
            <p class="muted">Use this page to check whether the learner can understand the pattern without technical language.</p>
            <p class="muted">ใช้หน้านี้ตรวจว่าผู้เรียนอ่านแล้วเข้าใจโครงสร้างได้ โดยไม่รู้สึกว่าเป็นภาษาวิชาการเกินไป</p>
        </div>
    </section>

    <section class="panel">
        <h3 class="detail-section-heading">Identity / ข้อมูลหลัก</h3>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="muted">Topic / หัวข้อ</span>
                <strong>@(rule.Topic?.Title ?? rule.GrammarTopicId.ToString())</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Status / สถานะ</span>
                <strong>@(rule.IsActive ? "Active / ใช้งาน" : "Inactive / ปิด")</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Slug</span>
                <strong>@rule.Slug</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Sort Order / ลำดับ</span>
                <strong>@rule.SortOrder</strong>
            </div>
        </div>

        <h3 class="detail-section-heading">Rule Content / เนื้อหากฎ</h3>
        <div class="detail-grid">
            <div class="detail-item full">
                <span class="muted">Rule Text / ข้อความกฎ</span>
                <strong>@rule.RuleText</strong>
            </div>
            <div class="detail-item full">
                <span class="muted">Structure Pattern / โครงสร้างประโยค</span>
                <strong>@rule.StructurePattern</strong>
            </div>
        </div>

        <h3 class="detail-section-heading">Explanations / คำอธิบาย</h3>
        <div class="detail-grid">
            <div class="detail-item full">
                <span class="muted">Thai Explanation / คำอธิบายภาษาไทย</span>
                <strong>@rule.ExplanationTh</strong>
            </div>
            <div class="detail-item full">
                <span class="muted">English Explanation / คำอธิบายภาษาอังกฤษ</span>
                <strong>@rule.ExplanationEn</strong>
            </div>
            <div class="detail-item full">
                <span class="muted">Common Mistake / จุดที่มักผิด</span>
                <strong>@rule.CommonMistake</strong>
            </div>
            <div class="detail-item full">
                <span class="muted">Correct Usage Note / วิธีใช้ที่ถูกต้อง</span>
                <strong>@rule.CorrectUsageNote</strong>
            </div>
        </div>
    </section>

    <section class="page-header section-header">
        <div>
            <p class="eyebrow">VOCABULARY / คำศัพท์</p>
            <h1>Related Words / คำศัพท์ที่เกี่ยวข้อง</h1>
        </div>
    </section>

    <section class="panel">
        @if (!string.IsNullOrWhiteSpace(relatedWordErrorMessage))
        {
            <div class="alert error">@relatedWordErrorMessage</div>
        }

        <div class="filters-grid">
            <label>
                <span>Word / คำศัพท์</span>
                <InputSelect class="input" @bind-Value="selectedWordId">
                    <option value="">Select word / เลือกคำศัพท์</option>
                    @foreach (var word in AvailableWords())
                    {
                        <option value="@word.Id">@word.Text</option>
                    }
                </InputSelect>
            </label>
            <button class="button" type="button" @onclick="AddRelatedWordAsync">Add Word / เพิ่มคำศัพท์</button>
        </div>
    </section>

    @if (rule.RelatedWords.Count == 0)
    {
        <section class="panel nested-table empty-state left-aligned">
            <span class="empty-state-icon"><Icon Name="word" Size="22" /></span>
            <strong>No related words yet / ยังไม่มีคำศัพท์ที่เกี่ยวข้อง</strong>
            <p>Add a word above to link it with this rule. / เลือกคำศัพท์ด้านบนเพื่อผูกกับกฎนี้</p>
        </section>
    }
    else
    {
        <section class="table-wrap nested-table">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Word / คำศัพท์</th>
                        <th>Meaning TH / ความหมายไทย</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var word in rule.RelatedWords)
                    {
                        <tr>
                            <td>
                                <strong>@word.Text</strong>
                                <span class="muted">@word.Slug</span>
                            </td>
                            <td>@word.MeaningTh</td>
                            <td class="row-actions">
                                <a class="button small" href="@AdminRoutes.Words.Detail(word.Id)" aria-label="View @word.Text" title="View"><Icon Name="eye" Size="15" /></a>
                                <button class="button small danger" type="button" @onclick="() => RemoveRelatedWordAsync(word.Id)" aria-label="Remove @word.Text" title="Remove"><Icon Name="trash" Size="15" /></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    <section class="page-header section-header">
        <div>
            <p class="eyebrow">EXAMPLES / ตัวอย่าง</p>
            <h1>Grammar Examples / ตัวอย่างประโยค</h1>
        </div>
    </section>

    @if (examples.Count == 0)
    {
        <section class="panel empty-state left-aligned">
            <span class="empty-state-icon"><Icon Name="grammar" Size="22" /></span>
            <strong>No grammar examples yet / ยังไม่มีตัวอย่าง</strong>
            <p>Add the first example using the form below. / เพิ่มตัวอย่างแรกจากฟอร์มด้านล่าง</p>
        </section>
    }
    else
    {
        var orderedExamples = examples.OrderBy(item => item.SortOrder).ThenBy(item => item.ExampleEn).ToList();

        <div class="repeater-list">
            @for (var index = 0; index < orderedExamples.Count; index++)
            {
                var example = orderedExamples[index];
                var displayIndex = index + 1;

                <div class="repeater-item">
                    <div class="repeater-item-header">
                        <span class="repeater-item-index">@displayIndex</span>
                        <span class="repeater-item-title">@example.ExampleEn</span>
                        <div class="row-actions">
                            <button class="button small" type="button" @onclick="() => EditExample(example)" aria-label="Edit example @displayIndex" title="Edit"><Icon Name="edit" Size="15" /></button>
                            <button class="button small danger" type="button" @onclick="() => DeleteExampleAsync(example.Id)" aria-label="Delete example @displayIndex" title="Delete"><Icon Name="trash" Size="15" /></button>
                        </div>
                    </div>
                    <div class="detail-grid">
                        <div class="detail-item full">
                            <span class="muted">Translation / คำแปล</span>
                            <strong>@example.TranslationTh</strong>
                        </div>
                        <div class="detail-item full">
                            <span class="muted">Thai Explanation / คำอธิบายไทย</span>
                            <strong>@example.ExplanationTh</strong>
                        </div>
                        <div class="detail-item">
                            <span class="muted">Type / ประเภท</span>
                            <strong>@(example.IsCorrectExample ? "Correct / ถูกต้อง" : "Mistake / ตัวอย่างผิด")</strong>
                        </div>
                        <div class="detail-item">
                            <span class="muted">Status / สถานะ</span>
                            <strong>@(example.IsActive ? "Active / ใช้งาน" : "Inactive / ปิด")</strong>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <section class="panel pair-form-panel">
        <h2>@(editingExampleId.HasValue ? "Edit Grammar Example / แก้ไขตัวอย่าง" : "Add Grammar Example / เพิ่มตัวอย่าง")</h2>
        @if (!string.IsNullOrWhiteSpace(exampleErrorMessage))
        {
            <div class="alert error">@exampleErrorMessage</div>
        }
        <GrammarExampleForm Model="exampleModel"
                            ValidationErrors="exampleValidationErrors"
                            IsSaving="isExampleSaving"
                            ShowActiveToggle="@editingExampleId.HasValue"
                            SubmitText="@(editingExampleId.HasValue ? "Save Example / บันทึก" : "Add Example / เพิ่ม")"
                            OnValidSubmit="SaveExampleAsync"
                            OnCancel="CancelExampleEditAsync" />
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private GrammarRuleDto? rule;
    private IReadOnlyCollection<GrammarExampleDto> examples = [];
    private IReadOnlyCollection<WordDto> words = [];
    private GrammarExampleFormModel exampleModel = new();
    private Guid? editingExampleId;
    private Guid? selectedWordId;
    private IReadOnlyDictionary<string, string[]> exampleValidationErrors = new Dictionary<string, string[]>();
    private string? errorMessage;
    private string? exampleErrorMessage;
    private string? relatedWordErrorMessage;
    private bool isLoading = true;
    private bool isExampleSaving;
    private bool notFound;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        notFound = false;
        errorMessage = null;

        try
        {
            words = (await WordsApiClient.SearchAsync(
                new WordSearchRequest(IsActive: true, PageSize: 100, SortBy: "Text", SortDirection: "Asc"),
                CancellationToken.None)).Items;
            rule = await GrammarApiClient.GetRuleAsync(Id, CancellationToken.None);
            if (rule is null)
            {
                notFound = true;
                return;
            }

            examples = await GrammarApiClient.GetExamplesByRuleIdAsync(Id, CancellationToken.None);
            if (!editingExampleId.HasValue)
            {
                ResetExampleForm();
            }
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<WordDto> AvailableWords()
    {
        var relatedWordIds = rule?.RelatedWords.Select(word => word.Id).ToHashSet() ?? [];
        return words.Where(word => !relatedWordIds.Contains(word.Id));
    }

    private async Task AddRelatedWordAsync()
    {
        if (rule is null || !selectedWordId.HasValue)
        {
            return;
        }

        relatedWordErrorMessage = null;

        try
        {
            await GrammarApiClient.AddRelatedWordAsync(rule.Id, selectedWordId.Value, CancellationToken.None);
            selectedWordId = null;
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            relatedWordErrorMessage = exception.Message;
        }
    }

    private async Task RemoveRelatedWordAsync(Guid wordId)
    {
        if (rule is null)
        {
            return;
        }

        relatedWordErrorMessage = null;

        try
        {
            await GrammarApiClient.RemoveRelatedWordAsync(rule.Id, wordId, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            relatedWordErrorMessage = exception.Message;
        }
    }

    private async Task SaveExampleAsync()
    {
        if (rule is null)
        {
            return;
        }

        isExampleSaving = true;
        exampleErrorMessage = null;
        exampleValidationErrors = new Dictionary<string, string[]>();

        try
        {
            if (editingExampleId.HasValue)
            {
                await GrammarApiClient.UpdateExampleAsync(
                    editingExampleId.Value,
                    exampleModel.ToUpdateRequest(),
                    CancellationToken.None);
            }
            else
            {
                await GrammarApiClient.AddExampleAsync(
                    rule.Id,
                    exampleModel.ToCreateRequest(),
                    CancellationToken.None);
            }

            editingExampleId = null;
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            exampleValidationErrors = exception.ValidationErrors;
            exampleErrorMessage = exampleValidationErrors.Count == 0 ? exception.Message : null;
        }
        finally
        {
            isExampleSaving = false;
        }
    }

    private void EditExample(GrammarExampleDto example)
    {
        editingExampleId = example.Id;
        exampleModel = GrammarExampleFormModel.FromDto(example);
        exampleErrorMessage = null;
        exampleValidationErrors = new Dictionary<string, string[]>();
    }

    private async Task DeleteExampleAsync(Guid id)
    {
        exampleErrorMessage = null;

        try
        {
            await GrammarApiClient.DeleteExampleAsync(id, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            exampleErrorMessage = exception.Message;
        }
    }

    private Task CancelExampleEditAsync()
    {
        editingExampleId = null;
        ResetExampleForm();
        return Task.CompletedTask;
    }

    private void ResetExampleForm()
    {
        exampleModel = new GrammarExampleFormModel
        {
            SortOrder = examples.Count
        };
        exampleErrorMessage = null;
        exampleValidationErrors = new Dictionary<string, string[]>();
    }
}
