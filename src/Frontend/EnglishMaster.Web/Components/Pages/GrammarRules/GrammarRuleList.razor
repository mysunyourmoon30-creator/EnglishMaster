@page "/admin/grammar-rules"
@rendermode InteractiveServer
@inject IGrammarApiClient GrammarApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Grammar Rules</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">GRAMMAR / ไวยากรณ์</p>
        <h1>Grammar Rules</h1>
        <p class="page-subtitle">Manage grammar rules, learner explanations, structure patterns, and examples. / จัดการกฎไวยากรณ์ คำอธิบาย โครงสร้างประโยค และตัวอย่างสำหรับผู้เรียน</p>
    </div>
    <a class="button primary" href="@AdminRoutes.GrammarRules.Create"><Icon Name="plus" Size="16" /> New Rule / เพิ่มกฎ</a>
</section>

<section class="panel release-note">
    <div>
        <strong>Recommended content / เนื้อหาที่ควรมี</strong>
        <p class="muted">A good rule should include a simple title, sentence pattern, Thai and English explanation, common mistake, and examples.</p>
        <p class="muted">กฎที่ดีควรมีชื่อที่เข้าใจง่าย โครงสร้างประโยค คำอธิบายไทย/อังกฤษ จุดที่มักผิด และตัวอย่างประกอบ</p>
    </div>
</section>

<section class="panel">
    <form class="filters-grid" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label>
            <span>Search / ค้นหา</span>
            <input class="input" placeholder="Title, pattern, or explanation / ชื่อ โครงสร้าง หรือคำอธิบาย" @bind="search" @bind:event="oninput" />
        </label>
        <label>
            <span>Topic / หัวข้อ</span>
            <select class="input" @bind="selectedTopicId">
                <option value="">All topics / ทุกหัวข้อ</option>
                @foreach (var topic in topics)
                {
                    <option value="@topic.Id">@topic.Title</option>
                }
            </select>
        </label>
        <label>
            <span>Status / สถานะ</span>
            <select class="input" @bind="activeFilter">
                <option value="true">Active / ใช้งาน</option>
                <option value="false">Inactive / ปิด</option>
                <option value="">All / ทั้งหมด</option>
            </select>
        </label>
        <label>
            <span>Page Size / จำนวนต่อหน้า</span>
            <select class="input" @bind="pageSize">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </label>
        <button class="button" type="submit">Search / ค้นหา</button>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}

@if (isLoading)
{
    <LoadingIndicator Text="Loading grammar rules... / กำลังโหลดกฎไวยากรณ์" />
}
else if (rules.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="grammar" Size="22" /></span>
        <strong>No grammar rules found / ไม่พบกฎไวยากรณ์</strong>
        <p>Try adjusting your filters, or create the first grammar rule. / ลองเปลี่ยนตัวกรอง หรือเพิ่มกฎแรก</p>
        <div class="actions">
            <a class="button primary" href="@AdminRoutes.GrammarRules.Create"><Icon Name="plus" Size="16" /> New Rule / เพิ่มกฎ</a>
        </div>
    </section>
}
else
{
    <section class="table-wrap">
        <div class="pagination-summary">
            <span class="muted">Page @searchResult.PageNumber of @searchResult.TotalPages / หน้า @searchResult.PageNumber จาก @searchResult.TotalPages</span>
            <span class="status-badge neutral">@searchResult.TotalCount rules / @searchResult.TotalCount กฎ</span>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Rule / กฎ</th>
                    <th>Topic / หัวข้อ</th>
                    <th>Sort / ลำดับ</th>
                    <th>Status / สถานะ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rule in rules)
                {
                    <tr>
                        <td>
                            <strong>@rule.Title</strong>
                            <span class="muted">@rule.StructurePattern</span>
                        </td>
                        <td>@(rule.Topic?.Title ?? rule.GrammarTopicId.ToString())</td>
                        <td>@rule.SortOrder</td>
                        <td>
                            <span class="status-badge @(rule.IsActive ? "success" : "muted")">
                                @(rule.IsActive ? "Active / ใช้งาน" : "Inactive / ปิด")
                            </span>
                        </td>
                        <td class="row-actions">
                            <a class="button small" href="@AdminRoutes.GrammarRules.Detail(rule.Id)" aria-label="View @rule.Title" title="View"><Icon Name="eye" Size="15" /></a>
                            <a class="button small" href="@AdminRoutes.GrammarRules.Edit(rule.Id)" aria-label="Edit @rule.Title" title="Edit"><Icon Name="edit" Size="15" /></a>
                            <button class="button small danger" type="button" @onclick="() => DeleteAsync(rule.Id, rule.Title)" aria-label="Delete @rule.Title" title="Delete"><Icon Name="trash" Size="15" /></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="pagination-row">
            <button class="button small" type="button" disabled="@(!searchResult.HasPreviousPage)" @onclick="PreviousPageAsync">Previous / ก่อนหน้า</button>
            <span class="muted">Page @searchResult.PageNumber / หน้า @searchResult.PageNumber</span>
            <button class="button small" type="button" disabled="@(!searchResult.HasNextPage)" @onclick="NextPageAsync">Next / ถัดไป</button>
        </div>
    </section>
}

@code {
    private IReadOnlyCollection<GrammarTopicDto> topics = [];
    private IReadOnlyCollection<GrammarRuleDto> rules = [];
    private GrammarRuleSearchResponse searchResult = EmptySearchResult();
    private string? search;
    private Guid? selectedTopicId;
    private string activeFilter = "true";
    private int pageNumber = 1;
    private int pageSize = 10;
    private string? errorMessage;
    private bool isLoading = true;

    [SupplyParameterFromQuery(Name = "topicId")]
    public Guid? TopicId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        selectedTopicId = TopicId;
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            topics = (await GrammarApiClient.SearchTopicsAsync(
                new GrammarTopicSearchRequest(IsActive: true, PageSize: 100),
                CancellationToken.None)).Items;
            searchResult = await GrammarApiClient.SearchRulesAsync(
                new GrammarRuleSearchRequest(
                    search,
                    selectedTopicId,
                    ParseActiveFilter(),
                    pageNumber,
                    pageSize),
                CancellationToken.None);
            rules = searchResult.Items;
        }
        catch (ApiRequestException exception)
        {
            searchResult = EmptySearchResult();
            rules = [];
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (!searchResult.HasPreviousPage)
        {
            return;
        }

        pageNumber--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (!searchResult.HasNextPage)
        {
            return;
        }

        pageNumber++;
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id, string title)
    {
        if (!await JsRuntime.InvokeAsync<bool>("confirm", $"Delete \"{title}\"? / ลบ \"{title}\"?"))
        {
            return;
        }

        errorMessage = null;

        try
        {
            await GrammarApiClient.DeleteRuleAsync(id, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
    }

    private bool? ParseActiveFilter()
    {
        return activeFilter switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
    }

    private static GrammarRuleSearchResponse EmptySearchResult()
    {
        return new GrammarRuleSearchResponse([], 1, 10, 0, 0, false, false);
    }
}
