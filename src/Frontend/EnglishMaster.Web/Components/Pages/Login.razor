@page "/login"
@layout PublicLayout

<PageTitle>Login / เข้าสู่ระบบ</PageTitle>

<style>
    .login-page-shell {
        align-items: center;
        display: grid;
        gap: 2rem;
        grid-template-columns: minmax(0, 1fr) minmax(20rem, 28rem);
        min-height: calc(100vh - 10rem);
    }

    .login-intro {
        display: grid;
        gap: 1rem;
        max-width: 38rem;
    }

    .login-intro h1 {
        font-size: clamp(2rem, 4vw, 3.5rem);
        line-height: 1.05;
        margin: 0;
    }

    .login-intro p {
        color: var(--color-muted, #607089);
        font-size: 1.05rem;
        margin: 0;
    }

    .login-card {
        background: #ffffff;
        border: 1px solid var(--color-border, #d8e0ea);
        border-radius: 12px;
        box-shadow: 0 20px 48px rgba(15, 35, 55, 0.16);
        display: grid;
        gap: 1rem;
        padding: 1.5rem;
    }

    .login-card h2 {
        font-size: 1.5rem;
        margin: 0;
    }

    .login-card label {
        display: grid;
        gap: 0.4rem;
    }

    .login-card label span {
        color: var(--color-muted, #607089);
        font-size: 0.9rem;
        font-weight: 700;
    }

    .login-card .input {
        box-sizing: border-box;
        min-height: 2.75rem;
        width: 100%;
    }

    .login-card .button {
        min-height: 2.75rem;
        width: 100%;
    }

    .login-help-row {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: space-between;
    }

    .login-help-row a {
        color: var(--color-primary-strong, #0b5f59);
        font-weight: 700;
        text-decoration: none;
    }

    @@media (max-width: 760px) {
        .login-page-shell {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="login-page-shell">
    <div class="login-intro">
        <p class="eyebrow">EnglishMaster / ระบบเรียนภาษาอังกฤษ</p>
        <h1>Sign in to continue / เข้าสู่ระบบเพื่อใช้งานต่อ</h1>
        <p>ใช้บัญชีผู้ดูแลหรือบัญชีผู้เรียนเพื่อจัดการเนื้อหา เรียน ฝึกทบทวน และติดตามความคืบหน้า.</p>
        <div class="actions">
            <a class="button secondary" href="/search"><Icon Name="search" Size="16" /> Search content / ค้นหาเนื้อหา</a>
            <a class="button secondary" href="/learn"><Icon Name="lesson" Size="16" /> Learn / เริ่มเรียน</a>
        </div>
    </div>

    <form class="login-card" method="post" action="/account/login">
        <AntiforgeryToken />
        <div>
            <p class="eyebrow">Secure Access / เข้าระบบอย่างปลอดภัย</p>
            <h2>Login / เข้าสู่ระบบ</h2>
        </div>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="alert error">@Error</div>
        }

        <label>
            <span>Email / อีเมล</span>
            <input class="input" name="email" type="email" autocomplete="username" placeholder="you@example.com" required />
        </label>

        <label>
            <span>Password / รหัสผ่าน</span>
            <input class="input" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required />
        </label>

        <button class="button primary" type="submit"><Icon Name="login" Size="16" /> Login / เข้าสู่ระบบ</button>

        <div class="login-help-row">
            <span class="muted">Local/Internal mode</span>
            <a href="/search">Continue browsing / ดูเนื้อหาก่อน</a>
        </div>
    </form>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }
}
