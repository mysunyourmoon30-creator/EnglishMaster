@page "/learn/recommendations"
@inject ILearningRecommendationApiClient RecommendationApiClient

<PageTitle>Recommendations / คำแนะนำ</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Learning Recommendations / คำแนะนำการเรียน</p>
        <h1>What to Learn Next / เรียนอะไรต่อดี</h1>
        <p class="page-subtitle">ระบบแนะนำเนื้อหาจากกิจกรรมการเรียนของคุณ เพื่อช่วยให้เลือกต่อได้ง่ายขึ้น.</p>
    </div>
    <div class="actions">
        <a class="button primary" href="/learn/study-plan">Study Plan / แผนวันนี้</a>
        <a class="button secondary" href="/learn/practice">Practice / ฝึก</a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (isLoading)
{
    <section class="panel empty-state">
        <strong>Loading recommendations... / กำลังโหลดคำแนะนำ</strong>
    </section>
}
else
{
    <RecommendationSection Title="Continue Learning / เรียนต่อ" Items="summary.ContinueLearning" />
    <RecommendationCards Title="Recommended Lessons / บทเรียนแนะนำ" Items="summary.RecommendedLessons" />
    <RecommendationCards Title="Recommended Words / คำศัพท์แนะนำ" Items="summary.RecommendedWords" />
    <RecommendationCards Title="Recommended Quizzes / แบบฝึกแนะนำ" Items="summary.RecommendedQuizzes" />
    <RecommendationCards Title="Review Weak Areas / จุดที่ควรทบทวน" Items="summary.ReviewRecommendations" />
    <RecommendationCards Title="Recommended Courses / คอร์สแนะนำ" Items="summary.RecommendedCourses" />
    <RecommendationCards Title="Recommended Grammar / ไวยากรณ์แนะนำ" Items="summary.RecommendedGrammar" />
}

@code {
    private LearningRecommendationSummaryDto summary = new([], [], [], [], [], [], []);
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            summary = await RecommendationApiClient.GetRecommendationsAsync(10, CancellationToken.None);
        }
        catch (ApiRequestException)
        {
            errorMessage = "Recommendations are unavailable right now. / ตอนนี้ยังโหลดคำแนะนำไม่ได้";
        }
        finally
        {
            isLoading = false;
        }
    }
}
