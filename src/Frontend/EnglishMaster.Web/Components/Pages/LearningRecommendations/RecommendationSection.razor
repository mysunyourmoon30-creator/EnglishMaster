@using EnglishMaster.Contracts.LearningRecommendations

<section class="content-section">
    <h2>@Title</h2>
    @if (Items.Count == 0)
    {
        <div class="panel empty-state">
            <span class="empty-state-icon"><Icon Name="revision" Size="20" /></span>
            <strong>Nothing in progress yet / ยังไม่มีรายการที่เรียนค้างไว้</strong>
            <p>เริ่มบทเรียน แบบฝึก หรือคำศัพท์ แล้วรายการที่ทำค้างไว้จะมาแสดงตรงนี้.</p>
        </div>
    }
    else
    {
        <div class="card-grid">
            @foreach (var item in Items)
            {
                <article class="list-card">
                    <div class="list-card-badges">
                        <span class="pill">@ContentTypeLabel(item.ContentType)</span>
                        <span class="pill">@item.ProgressPercent% done</span>
                    </div>
                    <h3><a href="@item.Url">@item.Title</a></h3>
                    <p>@item.Summary</p>
                    <p class="muted">@item.ProgressPercent% complete / สำเร็จแล้ว @item.ProgressPercent% · @GetReasonText(item)</p>
                </article>
            }
        </div>
    }
</section>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public IReadOnlyCollection<ContinueLearningItemDto> Items { get; set; } = [];

    private static string ContentTypeLabel(string value) => value.ToLowerInvariant() switch
    {
        "course" => "Course / คอร์ส",
        "lesson" => "Lesson / บทเรียน",
        "word" => "Word / คำศัพท์",
        "grammar" => "Grammar / ไวยากรณ์",
        "quiz" => "Quiz / แบบฝึก",
        _ => value
    };

    private static string GetReasonText(ContinueLearningItemDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.RecommendationReason))
        {
            return item.RecommendationReason;
        }

        return "Continue from where you left off / เรียนต่อจากจุดเดิม";
    }
}
