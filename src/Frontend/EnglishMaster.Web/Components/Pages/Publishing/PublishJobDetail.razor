@page "/admin/publishing/jobs/{Id:guid}"
@rendermode InteractiveServer
@inject IPublishingApiClient PublishingApiClient

<PageTitle>Publish Job</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Publishing</p>
        <h1>@(job?.Title ?? "Publish Job")</h1>
    </div>
    <a class="button" href="@AdminRoutes.Publishing.Jobs.Index">Back</a>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}

@if (isLoading)
{
    <p class="muted">Loading publish job...</p>
}
else if (job is null)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="publish" Size="22" /></span>
        <strong>Publish job was not found</strong>
        <p>It may have been deleted or the link is incorrect.</p>
        <div class="actions">
            <a class="button" href="@AdminRoutes.Publishing.Jobs.Index">Back to Publish Jobs</a>
        </div>
    </section>
}
else
{
    <section class="panel">
        <h3 class="detail-section-heading">Overview</h3>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="muted">Status</span>
                <strong>@job.Status</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Source</span>
                <strong>@job.SourceType</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Source Id</span>
                <strong>@job.SourceId</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Format</span>
                <strong>@job.Format</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Requested By</span>
                <strong>@(string.IsNullOrWhiteSpace(job.RequestedBy) ? "-" : job.RequestedBy)</strong>
            </div>
        </div>

        <h3 class="detail-section-heading">Output</h3>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="muted">Output</span>
                <strong>@(string.IsNullOrWhiteSpace(job.OutputFileName) ? "-" : job.OutputFileName)</strong>
            </div>
            @if (!string.IsNullOrWhiteSpace(job.ErrorMessage))
            {
                <div class="detail-item full">
                    <span class="muted">Error</span>
                    <strong>@job.ErrorMessage</strong>
                </div>
            }
        </div>

        <h3 class="detail-section-heading">Timing</h3>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="muted">Started</span>
                <strong>@(job.StartedAt.HasValue ? job.StartedAt.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) : "-")</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Completed</span>
                <strong>@(job.CompletedAt.HasValue ? job.CompletedAt.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) : "-")</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Created</span>
                <strong>@job.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Updated</span>
                <strong>@job.UpdatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</strong>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="form-actions">
            <button class="button primary" type="button" disabled="@(!CanRun || isBusy)" @onclick="RunAsync">Run</button>
            <button class="button danger" type="button" disabled="@(!CanCancel || isBusy)" @onclick="CancelAsync">Cancel</button>
        </div>
    </section>

    <section class="table-wrap">
        <h2><Icon Name="publish" Size="17" /> Artifacts</h2>
        @if (artifacts.Count == 0)
        {
            <section class="panel empty-state">
                <span class="empty-state-icon"><Icon Name="publish" Size="22" /></span>
                <strong>No artifacts yet</strong>
                <p>Run this job to generate output files.</p>
            </section>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Format</th>
                        <th>Size</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var artifact in artifacts)
                    {
                        <tr>
                            <td>@artifact.FileName</td>
                            <td>@artifact.Format</td>
                            <td>@artifact.FileSize</td>
                            <td class="row-actions">
                                @if (!string.IsNullOrWhiteSpace(artifact.PublicUrl))
                                {
                                    <a class="button small" href="@artifact.PublicUrl" target="_blank" aria-label="Open @artifact.FileName" title="Open"><Icon Name="eye" Size="15" /></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private PublishJobDto? job;
    private IReadOnlyCollection<PublishedArtifactDto> artifacts = [];
    private bool isLoading = true;
    private bool isBusy;
    private string? errorMessage;

    private bool CanRun => job?.Status is "Pending" or "Failed";
    private bool CanCancel => job?.Status is "Pending" or "Running" or "Failed";

    protected override Task OnInitializedAsync()
    {
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            job = await PublishingApiClient.GetJobAsync(Id, CancellationToken.None);
            artifacts = job is null
                ? []
                : await PublishingApiClient.GetArtifactsByJobAsync(Id, CancellationToken.None);
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RunAsync()
    {
        await ExecuteAsync(() => PublishingApiClient.RunJobAsync(Id, CancellationToken.None));
    }

    private async Task CancelAsync()
    {
        await ExecuteAsync(() => PublishingApiClient.CancelJobAsync(Id, CancellationToken.None));
    }

    private async Task ExecuteAsync(Func<Task<PublishJobDto>> action)
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            job = await action();
            artifacts = await PublishingApiClient.GetArtifactsByJobAsync(Id, CancellationToken.None);
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isBusy = false;
        }
    }
}
