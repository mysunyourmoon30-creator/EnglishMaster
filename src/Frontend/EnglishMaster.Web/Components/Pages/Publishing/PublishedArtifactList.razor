@page "/admin/publishing/artifacts"
@rendermode InteractiveServer
@inject IPublishingApiClient PublishingApiClient

<PageTitle>Published Artifacts</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Publishing</p>
        <h1>Published Artifacts</h1>
        <p class="page-subtitle">Review generated output files from completed publish jobs.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}

@if (isLoading)
{
    <p class="muted">Loading artifacts...</p>
}
else if (artifacts.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="publish" Size="22" /></span>
        <strong>No published artifacts found</strong>
        <p>Artifacts appear here once a publish job completes successfully.</p>
    </section>
}
else
{
    <section class="stat-grid">
        <div class="panel stat-card">
            <Icon Name="publish" Size="18" />
            <span class="stat-label">Total Artifacts</span>
            <span class="stat-value">@artifacts.Count</span>
        </div>
    </section>

    <section class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Source</th>
                    <th>Format</th>
                    <th>Size</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var artifact in artifacts)
                {
                    <tr>
                        <td><strong>@artifact.FileName</strong></td>
                        <td>@artifact.SourceType</td>
                        <td>@artifact.Format</td>
                        <td>@artifact.FileSize</td>
                        <td class="row-actions">
                            @if (!string.IsNullOrWhiteSpace(artifact.PublicUrl))
                            {
                                <a class="button small" href="@artifact.PublicUrl" target="_blank" aria-label="Open @artifact.FileName" title="Open"><Icon Name="eye" Size="15" /></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private IReadOnlyCollection<PublishedArtifactDto> artifacts = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            artifacts = (await PublishingApiClient.SearchArtifactsAsync(null, null, null, null, 1, 100, CancellationToken.None)).Items;
        }
        catch (ApiRequestException exception)
        {
            artifacts = [];
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
