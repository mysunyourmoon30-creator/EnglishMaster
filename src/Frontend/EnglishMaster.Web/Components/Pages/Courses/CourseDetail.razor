@page "/admin/courses/{Id:guid}"
@rendermode InteractiveServer
@inject ICourseApiClient CourseApiClient
@inject ILessonApiClient LessonApiClient

<PageTitle>@(course is null ? "Course" : course.Title)</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">COURSE / คอร์ส</p>
        <h1>@(course is null ? "Course" : course.Title)</h1>
        @if (course is not null)
        {
            <p class="page-subtitle">A course groups lessons into a guided learning path. / คอร์สใช้จัดบทเรียนหลายบทให้เป็นเส้นทางเรียน</p>
        }
    </div>
    <div class="actions">
        <a class="button" href="@AdminRoutes.Courses.Index">Back / กลับ</a>
        @if (course is not null)
        {
            <a class="button" href="@AdminRoutes.ContentRevisions.Timeline("Course", course.Id)"><Icon Name="revision" Size="15" /> History / ประวัติ</a>
            <a class="button primary" href="@AdminRoutes.Courses.Edit(course.Id)"><Icon Name="edit" Size="15" /> Edit / แก้ไข</a>
            <button class="button" type="button" @onclick="TogglePublishAsync">
                <Icon Name="publish" Size="15" /> @(course.IsPublished ? "Unpublish / ปิดเผยแพร่" : "Publish / เผยแพร่")
            </button>
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}

@if (isLoading)
{
    <p class="muted">Loading course... / กำลังโหลดคอร์ส</p>
}
else if (notFound)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="course" Size="22" /></span>
        <strong>Course was not found / ไม่พบคอร์ส</strong>
        <p>It may have been deleted or the link is incorrect. / อาจถูกลบแล้ว หรือลิงก์ไม่ถูกต้อง</p>
        <div class="actions">
            <a class="button" href="@AdminRoutes.Courses.Index">Back to Courses / กลับรายการคอร์ส</a>
        </div>
    </section>
}
else if (course is not null)
{
    <section class="panel">
        @if (course.ThumbnailMedia is not null)
        {
            <img class="thumbnail" src="@course.ThumbnailMedia.PublicUrl" alt="@course.ThumbnailMedia.AltText" />
        }

        <h3 class="detail-section-heading">Overview / ภาพรวม</h3>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="muted">Slug</span>
                <strong>@course.Slug</strong>
            </div>
            <div class="detail-item">
                <span class="muted">CEFR</span>
                <strong>@(course.CefrLevel ?? "-")</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Category / หมวดหมู่</span>
                <strong>@(course.Category?.Name ?? "-")</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Estimated Minutes / เวลาประมาณ</span>
                <strong>@course.EstimatedMinutes</strong>
            </div>
        </div>

        <h3 class="detail-section-heading">Publishing Status / สถานะเผยแพร่</h3>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="muted">Sort Order / ลำดับ</span>
                <strong>@course.SortOrder</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Published / เผยแพร่</span>
                <strong>@(course.IsPublished ? "Published / เผยแพร่แล้ว" : "Draft / ร่าง")</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Status / สถานะ</span>
                <strong>@(course.IsActive ? "Active / ใช้งาน" : "Inactive / ปิด")</strong>
            </div>
        </div>

        <h3 class="detail-section-heading">Description / คำอธิบาย</h3>
        <div class="detail-grid">
            <div class="detail-item full">
                <span class="muted">Summary / สรุป</span>
                <strong>@course.Summary</strong>
            </div>
            <div class="detail-item full">
                <span class="muted">Description / รายละเอียด</span>
                <strong>@course.Description</strong>
            </div>
        </div>
    </section>

    <section class="page-header section-header">
        <div>
            <p class="eyebrow">LEARNING PATH / เส้นทางเรียน</p>
            <h1>Lessons / บทเรียน</h1>
        </div>
    </section>

    <section class="panel">
        @if (!string.IsNullOrWhiteSpace(lessonErrorMessage))
        {
            <div class="alert error">@lessonErrorMessage</div>
        }

        <div class="filters-grid">
            <label>
                <span>Lesson / บทเรียน</span>
                <InputSelect class="input" @bind-Value="selectedLessonId">
                    <option value="">Select lesson / เลือกบทเรียน</option>
                    @foreach (var lesson in AvailableLessons())
                    {
                        <option value="@lesson.Id">@lesson.Title</option>
                    }
                </InputSelect>
            </label>
            <label class="checkbox-row">
                <InputCheckbox @bind-Value="selectedLessonIsRequired" />
                <span>Required / ต้องเรียน</span>
            </label>
            <button class="button" type="button" @onclick="AddLessonAsync">Add Lesson / เพิ่มบทเรียน</button>
        </div>
    </section>

    @if (courseLessons.Count == 0)
    {
        <section class="panel nested-table">
            <p class="muted">No lessons added yet. / ยังไม่มีบทเรียนในคอร์สนี้</p>
        </section>
    }
    else
    {
        <section class="table-wrap nested-table">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Lesson / บทเรียน</th>
                        <th>CEFR</th>
                        <th>Required / ต้องเรียน</th>
                        <th>Sort / ลำดับ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var relation in courseLessons.OrderBy(item => item.SortOrder))
                    {
                        <tr>
                            <td>
                                <strong>@relation.LessonTitle</strong>
                                <span class="muted">@relation.LessonSummary</span>
                            </td>
                            <td>@(relation.LessonCefrLevel ?? "-")</td>
                            <td>@(relation.IsRequired ? "Required / ต้องเรียน" : "Optional / เสริม")</td>
                            <td>@relation.SortOrder</td>
                            <td class="row-actions">
                                <button class="button small" type="button" @onclick="() => MoveLessonUpAsync(relation.Id)">Up / ขึ้น</button>
                                <button class="button small" type="button" @onclick="() => MoveLessonDownAsync(relation.Id)">Down / ลง</button>
                                <a class="button small" href="@AdminRoutes.Lessons.Detail(relation.LessonId)">View / ดู</a>
                                <button class="button small danger" type="button" @onclick="() => RemoveLessonAsync(relation.LessonId)">Remove / ลบออก</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CourseDto? course;
    private IReadOnlyCollection<CourseLessonDto> courseLessons = [];
    private IReadOnlyCollection<LessonDto> lessons = [];
    private Guid? selectedLessonId;
    private bool selectedLessonIsRequired = true;
    private string? errorMessage;
    private string? lessonErrorMessage;
    private bool isLoading = true;
    private bool notFound;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        notFound = false;
        errorMessage = null;

        try
        {
            lessons = (await LessonApiClient.SearchAsync(
                new LessonSearchRequest(IsActive: true, PageSize: 100, SortBy: "Title", SortDirection: "Asc"),
                CancellationToken.None)).Items;

            course = await CourseApiClient.GetAsync(Id, CancellationToken.None);
            if (course is null)
            {
                notFound = true;
                return;
            }

            courseLessons = await CourseApiClient.GetLessonsAsync(Id, CancellationToken.None);
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<LessonDto> AvailableLessons()
    {
        var relatedLessonIds = courseLessons.Select(item => item.LessonId).ToHashSet();
        return lessons.Where(lesson => !relatedLessonIds.Contains(lesson.Id));
    }

    private async Task TogglePublishAsync()
    {
        if (course is null)
        {
            return;
        }

        errorMessage = null;

        try
        {
            if (course.IsPublished)
            {
                await CourseApiClient.UnpublishAsync(course.Id, CancellationToken.None);
            }
            else
            {
                await CourseApiClient.PublishAsync(course.Id, CancellationToken.None);
            }

            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
    }

    private async Task AddLessonAsync()
    {
        if (course is null || !selectedLessonId.HasValue)
        {
            return;
        }

        lessonErrorMessage = null;

        try
        {
            await CourseApiClient.AddLessonAsync(
                course.Id,
                selectedLessonId.Value,
                courseLessons.Count,
                selectedLessonIsRequired,
                CancellationToken.None);
            selectedLessonId = null;
            selectedLessonIsRequired = true;
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            lessonErrorMessage = exception.Message;
        }
    }

    private async Task RemoveLessonAsync(Guid lessonId)
    {
        if (course is null)
        {
            return;
        }

        lessonErrorMessage = null;

        try
        {
            await CourseApiClient.RemoveLessonAsync(course.Id, lessonId, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            lessonErrorMessage = exception.Message;
        }
    }

    private async Task MoveLessonUpAsync(Guid id)
    {
        await MoveLessonAsync(id, -1);
    }

    private async Task MoveLessonDownAsync(Guid id)
    {
        await MoveLessonAsync(id, 1);
    }

    private async Task MoveLessonAsync(Guid id, int offset)
    {
        if (course is null)
        {
            return;
        }

        var ordered = courseLessons.OrderBy(item => item.SortOrder).Select(item => item.Id).ToList();
        var index = ordered.IndexOf(id);
        var newIndex = index + offset;
        if (index < 0 || newIndex < 0 || newIndex >= ordered.Count)
        {
            return;
        }

        (ordered[index], ordered[newIndex]) = (ordered[newIndex], ordered[index]);
        lessonErrorMessage = null;

        try
        {
            await CourseApiClient.ReorderLessonsAsync(course.Id, ordered, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            lessonErrorMessage = exception.Message;
        }
    }
}
