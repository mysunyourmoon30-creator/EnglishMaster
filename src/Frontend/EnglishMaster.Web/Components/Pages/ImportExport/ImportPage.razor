@page "/admin/import"
@rendermode InteractiveServer
@inject IImportExportApiClient ImportExportApiClient

<PageTitle>Import</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Content Operations</p>
        <h1>Import</h1>
        <p class="page-subtitle">Bulk-import vocabulary entries from a CSV or JSON file.</p>
    </div>
</section>

<section class="panel">
    <h2><Icon Name="word" Size="17" /> Words</h2>
    <div class="upload-dropzone">
        <Icon Name="import" Size="28" />
        <strong>Drop a file here or click to browse</strong>
        <p class="muted">Supported: CSV or JSON.</p>
        <InputFile OnChange="OnFileSelected" accept=".csv,.json,text/csv,application/json" />
        @if (selectedFile is not null)
        {
            <p class="muted">@selectedFile.Name - @selectedFile.ContentType</p>
        }
    </div>
    <div class="form-actions">
        <button class="button primary" type="button" disabled="@(selectedFile is null || isImporting)" @onclick="ImportWordsAsync">
            <Icon Name="import" Size="16" /> @(isImporting ? "Importing..." : "Import Words")
        </button>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}

@if (importResult is not null)
{
    <section class="panel">
        <h2>Import Result</h2>
        <div class="stat-grid">
            <div class="panel stat-card">
                <span class="stat-label">Rows</span>
                <span class="stat-value">@importResult.TotalRows</span>
            </div>
            <div class="panel stat-card">
                <span class="stat-label">Imported</span>
                <span class="stat-value">@importResult.ImportedCount</span>
            </div>
            <div class="panel stat-card @(importResult.FailedCount > 0 ? "status-bad" : "status-ok")">
                <span class="stat-label">Failed</span>
                <span class="stat-value">@importResult.FailedCount</span>
            </div>
        </div>

        @if (importResult.Errors.Count > 0)
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Row</th>
                        <th>Field</th>
                        <th>Error</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var error in importResult.Errors)
                    {
                        <tr>
                            <td>@error.RowNumber</td>
                            <td>@error.Field</td>
                            <td>@error.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

<section class="panel">
    <h2>Format</h2>
    <table class="data-table">
        <thead>
            <tr>
                <th>Column</th>
                <th>Required</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var field in WordFields)
            {
                <tr>
                    <td>@field.Name</td>
                    <td>@(field.Required ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    private const long MaximumFileSize = 1_048_576;

    private static readonly IReadOnlyCollection<ImportField> WordFields =
    [
        new("Text", true),
        new("MeaningTh", true),
        new("PartOfSpeech", true),
        new("CefrLevel", true),
        new("IpaUk", false),
        new("IpaUs", false),
        new("ThaiReading", false),
        new("MeaningEn", false),
        new("ExampleEn", false),
        new("ExampleTh", false),
        new("CategorySlug", false),
        new("Tags", false)
    ];

    private IBrowserFile? selectedFile;
    private ContentImportResult? importResult;
    private string? errorMessage;
    private bool isImporting;

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        importResult = null;
        errorMessage = null;
    }

    private async Task ImportWordsAsync()
    {
        if (selectedFile is null)
        {
            errorMessage = "Choose a CSV or JSON file.";
            return;
        }

        isImporting = true;
        importResult = null;
        errorMessage = null;

        try
        {
            await using var stream = selectedFile.OpenReadStream(MaximumFileSize);
            importResult = await ImportExportApiClient.ImportWordsAsync(
                stream,
                selectedFile.Name,
                selectedFile.ContentType,
                CancellationToken.None);
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        catch (IOException)
        {
            errorMessage = "The selected file could not be read.";
        }
        finally
        {
            isImporting = false;
        }
    }

    private sealed record ImportField(string Name, bool Required);
}
