@page "/admin/words"
@rendermode InteractiveServer
@inject IWordsApiClient WordsApiClient
@inject ICategoriesApiClient CategoriesApiClient
@inject ITagsApiClient TagsApiClient

<PageTitle>Words / คำศัพท์</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">VOCABULARY / คำศัพท์</p>
        <h1>Words</h1>
        <p class="page-subtitle">Manage the real 2,500 learner words with meanings, examples, CEFR level, categories, and tags. / จัดการคำศัพท์จริง 2,500 คำ พร้อมความหมาย ตัวอย่าง ระดับ CEFR หมวดหมู่ และป้ายกำกับ</p>
    </div>
    <div class="actions">
        <a class="button" href="/search?type=word">Learner search / หน้าค้นหาผู้เรียน</a>
        <a class="button primary" href="@AdminRoutes.Words.Create"><Icon Name="plus" Size="16" /> New Word / เพิ่มคำ</a>
    </div>
</section>

<section class="panel word-mode-panel">
    <div>
        <strong>View / มุมมอง</strong>
        <p class="muted">Keep real learning words separate from inactive performance test data. / แยกคำศัพท์ที่ใช้เรียนจริงออกจากข้อมูลทดสอบ performance ที่ปิดใช้งานไว้</p>
    </div>
    <div class="segmented-actions" role="group" aria-label="Word view mode">
        <button class="button @(viewMode == WordViewMode.Learner ? "primary" : null)" type="button" @onclick="ShowLearnerWordsAsync">
            Learning words / คำเรียนจริง
        </button>
        <button class="button @(viewMode == WordViewMode.Performance ? "primary" : null)" type="button" @onclick="ShowPerformanceWordsAsync">
            Performance data / ข้อมูลทดสอบ
        </button>
        <button class="button @(viewMode == WordViewMode.All ? "primary" : null)" type="button" @onclick="ShowAllWordsAsync">
            All / ทั้งหมด
        </button>
    </div>
</section>

<section class="panel release-note">
    <div>
        <strong>Recommended checks / สิ่งที่ควรตรวจ</strong>
        <p class="muted">For learner words, check meaning, example sentence, CEFR, Common Rank tag, and active status before publishing to lessons and practice.</p>
        <p class="muted">สำหรับคำเรียนจริง ให้ตรวจความหมาย ตัวอย่าง ระดับ CEFR tag กลุ่มความนิยม และสถานะ Active ก่อนนำไปใช้ในบทเรียน/แบบฝึก</p>
    </div>
</section>

<section class="panel">
    <form class="filters-grid" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label>
            <span>Search / ค้นหา</span>
            <input class="input" placeholder="word, meaning, or slug / คำ ความหมาย หรือ slug" @bind="search" @bind:event="oninput" />
        </label>
        <label>
            <span>CEFR / ระดับ</span>
            <select class="input" @bind="cefrLevel">
                <option value="">All levels / ทุกระดับ</option>
                @foreach (var option in CefrLevelOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </label>
        <label>
            <span>Part of Speech / ชนิดคำ</span>
            <select class="input" @bind="partOfSpeech">
                <option value="">All parts / ทุกชนิด</option>
                @foreach (var option in PartOfSpeechOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </label>
        <label>
            <span>Status / สถานะ</span>
            <select class="input" @bind="activeFilter">
                <option value="true">Active / ใช้งาน</option>
                <option value="false">Inactive / ปิด</option>
            </select>
        </label>
        <label>
            <span>Category / หมวดหมู่</span>
            <select class="input" @bind="categoryFilter">
                <option value="">All categories / ทุกหมวด</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </label>
        <label>
            <span>Tag / ป้ายกำกับ</span>
            <select class="input" @bind="tagFilter">
                <option value="">All tags / ทุกป้าย</option>
                @foreach (var tag in tags)
                {
                    <option value="@tag.Id">@tag.Name</option>
                }
            </select>
        </label>
        <label>
            <span>Sort By / เรียงตาม</span>
            <select class="input" @bind="sortBy">
                <option value="CreatedAt">Frequency Rank / ลำดับความนิยม</option>
                <option value="Text">Text / ตัวอักษร</option>
            </select>
        </label>
        <label>
            <span>Direction / ทิศทาง</span>
            <select class="input" @bind="sortDirection">
                <option value="Asc">Ascending / น้อยไปมาก</option>
                <option value="Desc">Descending / มากไปน้อย</option>
            </select>
        </label>
        <label>
            <span>Page Size / จำนวนต่อหน้า</span>
            <select class="input" @bind="pageSize">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </label>
        <button class="button" type="submit">Search / ค้นหา</button>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}

@if (isLoading)
{
    <p class="muted">Loading words... / กำลังโหลดคำศัพท์</p>
}
else if (words.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="word" Size="22" /></span>
        <strong>No words found / ยังไม่พบคำศัพท์</strong>
        <p>Try changing filters or add a real learner word. / ลองเปลี่ยนตัวกรอง หรือเพิ่มคำศัพท์จริงสำหรับผู้เรียน</p>
        <div class="actions">
            <a class="button primary" href="@AdminRoutes.Words.Create"><Icon Name="plus" Size="16" /> New Word / เพิ่มคำ</a>
        </div>
    </section>
}
else
{
    <section class="table-wrap">
        <div class="pagination-summary">
            <span class="muted">Page @searchResult.PageNumber of @searchResult.TotalPages / หน้า @searchResult.PageNumber จาก @searchResult.TotalPages</span>
            <span class="status-badge neutral">@GetViewModeLabel()</span>
            <span class="status-badge neutral">@searchResult.TotalCount words / @searchResult.TotalCount คำ</span>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Word / คำ</th>
                    <th>Meaning / ความหมาย</th>
                    <th>Category / หมวดหมู่</th>
                    <th>Tags / ป้าย</th>
                    <th>Part / ชนิดคำ</th>
                    <th>CEFR</th>
                    <th>Status / สถานะ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var word in words)
                {
                    <tr>
                        <td>
                            <strong>@word.Text</strong>
                            <span class="muted">@word.IpaUk / @word.ThaiReading</span>
                            <span class="category-slug">@word.Slug</span>
                        </td>
                        <td>
                            <strong>@word.MeaningEn</strong>
                            <span class="muted">@word.MeaningTh</span>
                            <span class="muted">@word.ExampleEn</span>
                        </td>
                        <td>@(word.Category?.Name ?? "-")</td>
                        <td>@FormatTags(word.Tags)</td>
                        <td>@word.PartOfSpeech</td>
                        <td>@word.CefrLevel</td>
                        <td>
                            <span class="status-badge @(word.IsActive ? "success" : "muted")">
                                @(word.IsActive ? "Active / ใช้งาน" : "Inactive / ปิด")
                            </span>
                            @if (IsPerformanceWord(word))
                            {
                                <span class="status-badge warning">Performance</span>
                            }
                        </td>
                        <td class="row-actions">
                            <a class="button small" href="@AdminRoutes.Words.Detail(word.Id)" aria-label="View @word.Text" title="View"><Icon Name="eye" Size="15" /></a>
                            <a class="button small" href="@AdminRoutes.Words.Edit(word.Id)" aria-label="Edit @word.Text" title="Edit"><Icon Name="edit" Size="15" /></a>
                            <button class="button small danger" type="button" @onclick="() => DeleteAsync(word.Id)" aria-label="Delete @word.Text" title="Delete"><Icon Name="trash" Size="15" /></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="pagination-row">
            <button class="button small" type="button" disabled="@(!searchResult.HasPreviousPage)" @onclick="PreviousPageAsync">Previous / ก่อนหน้า</button>
            <span class="muted">Page @searchResult.PageNumber / หน้า @searchResult.PageNumber</span>
            <button class="button small" type="button" disabled="@(!searchResult.HasNextPage)" @onclick="NextPageAsync">Next / ถัดไป</button>
        </div>
    </section>
}

@code {
    private enum WordViewMode
    {
        Learner,
        Performance,
        All
    }

    private static readonly string[] PartOfSpeechOptions =
    [
        "Noun",
        "Pronoun",
        "Verb",
        "Adjective",
        "Adverb",
        "Preposition",
        "Conjunction",
        "Interjection",
        "Determiner",
        "Phrase",
        "Other"
    ];

    private static readonly string[] CefrLevelOptions = ["A1", "A2", "B1", "B2", "C1", "C2"];

    private IReadOnlyCollection<WordDto> words = [];
    private IReadOnlyCollection<CategoryDto> categories = [];
    private IReadOnlyCollection<TagDto> tags = [];
    private WordSearchResponse searchResult = EmptySearchResult();
    private string? search;
    private string? cefrLevel;
    private string? partOfSpeech;
    private string activeFilter = "true";
    private string? categoryFilter;
    private string? tagFilter;
    private string sortBy = "CreatedAt";
    private string sortDirection = "Asc";
    private int pageNumber = 1;
    private int pageSize = 10;
    private string? errorMessage;
    private bool isLoading = true;
    private WordViewMode viewMode = WordViewMode.Learner;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupsAsync();
        await LoadAsync();
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            categories = (await CategoriesApiClient.SearchAsync(null, true, CancellationToken.None)).Items;
            tags = (await TagsApiClient.SearchAsync(null, true, CancellationToken.None)).Items;
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
    }

    private async Task SearchAsync()
    {
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            searchResult = await WordsApiClient.SearchAsync(
                new WordSearchRequest(
                    GetEffectiveSearch(),
                    string.IsNullOrWhiteSpace(cefrLevel) ? null : cefrLevel,
                    string.IsNullOrWhiteSpace(partOfSpeech) ? null : partOfSpeech,
                    activeFilter == "false" ? false : true,
                    ParseGuid(categoryFilter),
                    ParseGuid(tagFilter),
                    pageNumber,
                    pageSize,
                    sortBy,
                    sortDirection),
                CancellationToken.None);
            words = FilterWordsForView(searchResult.Items).ToArray();
        }
        catch (ApiRequestException exception)
        {
            searchResult = EmptySearchResult();
            words = [];
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (!searchResult.HasPreviousPage)
        {
            return;
        }

        pageNumber--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (!searchResult.HasNextPage)
        {
            return;
        }

        pageNumber++;
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        errorMessage = null;

        try
        {
            await WordsApiClient.DeleteAsync(id, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
    }

    private async Task ShowLearnerWordsAsync()
    {
        viewMode = WordViewMode.Learner;
        if (IsPerformanceSearch(search))
        {
            search = null;
        }

        activeFilter = "true";
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task ShowPerformanceWordsAsync()
    {
        viewMode = WordViewMode.Performance;
        search = "perf";
        activeFilter = "false";
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task ShowAllWordsAsync()
    {
        viewMode = WordViewMode.All;
        pageNumber = 1;
        await LoadAsync();
    }

    private string? GetEffectiveSearch()
    {
        if (viewMode == WordViewMode.Performance && string.IsNullOrWhiteSpace(search))
        {
            return "perf";
        }

        return search;
    }

    private IEnumerable<WordDto> FilterWordsForView(IEnumerable<WordDto> source)
    {
        return viewMode switch
        {
            WordViewMode.Learner => source.Where(word => !IsPerformanceWord(word)),
            WordViewMode.Performance => source.Where(IsPerformanceWord),
            _ => source
        };
    }

    private string GetViewModeLabel()
    {
        return viewMode switch
        {
            WordViewMode.Performance => "Performance data / ข้อมูลทดสอบ",
            WordViewMode.All => "All words / คำทั้งหมด",
            _ => "Learning words / คำเรียนจริง"
        };
    }

    private static WordSearchResponse EmptySearchResult()
    {
        return new WordSearchResponse([], 1, 10, 0, 0, false, false);
    }

    private static Guid? ParseGuid(string? value)
    {
        return Guid.TryParse(value, out var id) ? id : null;
    }

    private static string FormatTags(IReadOnlyCollection<WordTagDto> wordTags)
    {
        return wordTags.Count == 0
            ? "-"
            : string.Join(", ", wordTags.Select(tag => tag.Name));
    }

    private static bool IsPerformanceWord(WordDto word)
    {
        return IsPerformanceSearch(word.Slug) || IsPerformanceSearch(word.Text);
    }

    private static bool IsPerformanceSearch(string? value)
    {
        return value?.StartsWith("perf", StringComparison.OrdinalIgnoreCase) == true ||
            value?.StartsWith("word-000", StringComparison.OrdinalIgnoreCase) == true;
    }
}
