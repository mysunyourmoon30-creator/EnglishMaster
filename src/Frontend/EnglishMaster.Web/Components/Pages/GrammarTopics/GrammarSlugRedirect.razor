@page "/grammar/{Slug}"
@rendermode InteractiveServer
@layout PublicLayout
@inject NavigationManager NavigationManager

<PageTitle>Finding grammar / กำลังค้นหาไวยากรณ์</PageTitle>

<section class="panel empty-state">
    <LoadingIndicator Text="Finding grammar... / กำลังค้นหาไวยากรณ์" />
</section>

@code {
    [Parameter]
    public string? Slug { get; set; }

    protected override void OnParametersSet()
    {
        var query = string.IsNullOrWhiteSpace(Slug)
            ? "/search?type=grammar"
            : $"/search?q={Uri.EscapeDataString(Slug.Trim())}&type=grammar";
        NavigationManager.NavigateTo(query, replace: true);
    }
}
