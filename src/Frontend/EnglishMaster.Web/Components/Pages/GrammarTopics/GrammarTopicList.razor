@page "/admin/grammar-topics"
@rendermode InteractiveServer
@inject IGrammarApiClient GrammarApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Grammar Topics</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">GRAMMAR / ไวยากรณ์</p>
        <h1>Grammar Topics</h1>
        <p class="page-subtitle">Organize grammar by level, then add rules and examples under each topic. / จัดหมวดไวยากรณ์ตามระดับ แล้วเพิ่มกฎและตัวอย่างในแต่ละหัวข้อ</p>
    </div>
    <a class="button primary" href="@AdminRoutes.GrammarTopics.Create"><Icon Name="plus" Size="16" /> New Topic / เพิ่มหัวข้อ</a>
</section>

<section class="panel release-note">
    <div>
        <strong>Recommended structure / โครงสร้างที่แนะนำ</strong>
        <p class="muted">Start with broad learner topics such as Tenses, Modals, Questions, Prepositions, and Conditionals, then add clear rules inside each topic.</p>
        <p class="muted">เริ่มจากหัวข้อใหญ่ที่ผู้เรียนเข้าใจง่าย เช่น Tenses, Modals, Questions, Prepositions, Conditionals แล้วค่อยเพิ่มกฎย่อย</p>
    </div>
</section>

<section class="panel">
    <form class="filters-grid" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label>
            <span>Search / ค้นหา</span>
            <input class="input" placeholder="Topic title or summary / ชื่อหัวข้อหรือสรุป" @bind="search" @bind:event="oninput" />
        </label>
        <label>
            <span>CEFR</span>
            <select class="input" @bind="cefrLevel">
                <option value="">All / ทุกระดับ</option>
                @foreach (var level in CefrLevels)
                {
                    <option value="@level">@level</option>
                }
            </select>
        </label>
        <label>
            <span>Status / สถานะ</span>
            <select class="input" @bind="activeFilter">
                <option value="true">Active / ใช้งาน</option>
                <option value="false">Inactive / ปิด</option>
                <option value="">All / ทั้งหมด</option>
            </select>
        </label>
        <label>
            <span>Page Size / จำนวนต่อหน้า</span>
            <select class="input" @bind="pageSize">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </label>
        <button class="button" type="submit">Search / ค้นหา</button>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}

@if (isLoading)
{
    <LoadingIndicator Text="Loading grammar topics... / กำลังโหลดหัวข้อไวยากรณ์" />
}
else if (topics.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="grammar" Size="22" /></span>
        <strong>No grammar topics found / ไม่พบหัวข้อไวยากรณ์</strong>
        <p>Try adjusting your filters, or create the first grammar topic. / ลองเปลี่ยนตัวกรอง หรือเพิ่มหัวข้อแรก</p>
        <div class="actions">
            <a class="button primary" href="@AdminRoutes.GrammarTopics.Create"><Icon Name="plus" Size="16" /> New Topic / เพิ่มหัวข้อ</a>
        </div>
    </section>
}
else
{
    <section class="table-wrap">
        <div class="pagination-summary">
            <span class="muted">Page @searchResult.PageNumber of @searchResult.TotalPages / หน้า @searchResult.PageNumber จาก @searchResult.TotalPages</span>
            <span class="status-badge neutral">@searchResult.TotalCount topics / @searchResult.TotalCount หัวข้อ</span>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Topic / หัวข้อ</th>
                    <th>CEFR</th>
                    <th>Sort / ลำดับ</th>
                    <th>Status / สถานะ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var topic in topics)
                {
                    <tr>
                        <td>
                            <strong>@topic.Title</strong>
                            <span class="muted">@topic.Summary</span>
                        </td>
                        <td>@topic.CefrLevel</td>
                        <td>@topic.SortOrder</td>
                        <td>
                            <span class="status-badge @(topic.IsActive ? "success" : "muted")">
                                @(topic.IsActive ? "Active / ใช้งาน" : "Inactive / ปิด")
                            </span>
                        </td>
                        <td class="row-actions">
                            <a class="button small" href="@AdminRoutes.GrammarTopics.Detail(topic.Id)" aria-label="View @topic.Title" title="View"><Icon Name="eye" Size="15" /></a>
                            <a class="button small" href="@AdminRoutes.GrammarTopics.Edit(topic.Id)" aria-label="Edit @topic.Title" title="Edit"><Icon Name="edit" Size="15" /></a>
                            <a class="button small" href="@AdminRoutes.GrammarRules.IndexForTopic(topic.Id)" aria-label="Rules for @topic.Title" title="Rules"><Icon Name="chevron-right" Size="15" /></a>
                            <button class="button small danger" type="button" @onclick="() => DeleteAsync(topic.Id, topic.Title)" aria-label="Delete @topic.Title" title="Delete"><Icon Name="trash" Size="15" /></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="pagination-row">
            <button class="button small" type="button" disabled="@(!searchResult.HasPreviousPage)" @onclick="PreviousPageAsync">Previous / ก่อนหน้า</button>
            <span class="muted">Page @searchResult.PageNumber / หน้า @searchResult.PageNumber</span>
            <button class="button small" type="button" disabled="@(!searchResult.HasNextPage)" @onclick="NextPageAsync">Next / ถัดไป</button>
        </div>
    </section>
}

@code {
    private static readonly string[] CefrLevels = ["A1", "A2", "B1", "B2", "C1", "C2"];

    private IReadOnlyCollection<GrammarTopicDto> topics = [];
    private GrammarTopicSearchResponse searchResult = EmptySearchResult();
    private string? search;
    private string? cefrLevel;
    private string activeFilter = "true";
    private int pageNumber = 1;
    private int pageSize = 10;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            searchResult = await GrammarApiClient.SearchTopicsAsync(
                new GrammarTopicSearchRequest(
                    search,
                    string.IsNullOrWhiteSpace(cefrLevel) ? null : cefrLevel,
                    ParseActiveFilter(),
                    pageNumber,
                    pageSize),
                CancellationToken.None);
            topics = searchResult.Items;
        }
        catch (ApiRequestException exception)
        {
            searchResult = EmptySearchResult();
            topics = [];
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (!searchResult.HasPreviousPage)
        {
            return;
        }

        pageNumber--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (!searchResult.HasNextPage)
        {
            return;
        }

        pageNumber++;
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id, string title)
    {
        if (!await JsRuntime.InvokeAsync<bool>("confirm", $"Delete \"{title}\"? / ลบ \"{title}\"?"))
        {
            return;
        }

        errorMessage = null;

        try
        {
            await GrammarApiClient.DeleteTopicAsync(id, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
    }

    private bool? ParseActiveFilter()
    {
        return activeFilter switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
    }

    private static GrammarTopicSearchResponse EmptySearchResult()
    {
        return new GrammarTopicSearchResponse([], 1, 10, 0, 0, false, false);
    }
}
