@page "/admin/grammar-topics/{Id:guid}"
@rendermode InteractiveServer
@inject IGrammarApiClient GrammarApiClient

<PageTitle>@(topic is null ? "Grammar Topic" : topic.Title)</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">GRAMMAR TOPIC / หัวข้อไวยากรณ์</p>
        <h1>@(topic is null ? "Grammar Topic" : topic.Title)</h1>
        @if (topic is not null)
        {
            <p class="page-subtitle">Review this topic and the grammar rules learners will study inside it. / ตรวจหัวข้อนี้และกฎไวยากรณ์ที่ผู้เรียนจะเรียนภายในหัวข้อนี้</p>
        }
    </div>
    <div class="actions">
        <a class="button" href="@AdminRoutes.GrammarTopics.Index">Back / กลับ</a>
        @if (topic is not null)
        {
            <a class="button" href="@AdminRoutes.GrammarRules.CreateForTopic(topic.Id)"><Icon Name="plus" Size="15" /> New Rule / เพิ่มกฎ</a>
            <a class="button primary" href="@AdminRoutes.GrammarTopics.Edit(topic.Id)"><Icon Name="edit" Size="15" /> Edit / แก้ไข</a>
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}

@if (isLoading)
{
    <p class="muted">Loading grammar topic... / กำลังโหลดหัวข้อไวยากรณ์</p>
}
else if (notFound)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="grammar" Size="22" /></span>
        <strong>Grammar topic was not found / ไม่พบหัวข้อไวยากรณ์</strong>
        <p>It may have been deleted or the link is incorrect. / อาจถูกลบแล้ว หรือลิงก์ไม่ถูกต้อง</p>
        <div class="actions">
            <a class="button" href="@AdminRoutes.GrammarTopics.Index">Back to Grammar Topics / กลับรายการหัวข้อ</a>
        </div>
    </section>
}
else if (topic is not null)
{
    <section class="panel release-note">
        <div>
            <strong>@rules.Count rules in this topic / มีกฎ @rules.Count รายการในหัวข้อนี้</strong>
            <p class="muted">Keep each rule short, practical, and connected to examples. / แต่ละกฎควรสั้น ใช้ได้จริง และมีตัวอย่างประกอบ</p>
        </div>
    </section>

    <section class="panel">
        <h3 class="detail-section-heading">Identity / ข้อมูลหลัก</h3>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="muted">Slug</span>
                <strong>@topic.Slug</strong>
            </div>
            <div class="detail-item">
                <span class="muted">CEFR</span>
                <strong>@topic.CefrLevel</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Sort Order / ลำดับ</span>
                <strong>@topic.SortOrder</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Status / สถานะ</span>
                <strong>@(topic.IsActive ? "Active / ใช้งาน" : "Inactive / ปิด")</strong>
            </div>
        </div>

        <h3 class="detail-section-heading">Description / คำอธิบาย</h3>
        <div class="detail-grid">
            <div class="detail-item full">
                <span class="muted">Summary / สรุป</span>
                <strong>@topic.Summary</strong>
            </div>
        </div>
    </section>

    <section class="page-header section-header">
        <div>
            <p class="eyebrow">RULES / กฎ</p>
            <h1>Grammar Rules / กฎในหัวข้อนี้</h1>
        </div>
    </section>

    @if (rules.Count == 0)
    {
        <section class="panel empty-state left-aligned">
            <span class="empty-state-icon"><Icon Name="grammar" Size="22" /></span>
            <strong>No grammar rules found for this topic / หัวข้อนี้ยังไม่มีกฎ</strong>
            <p>Create the first rule to start building this topic's content. / เพิ่มกฎแรกเพื่อเริ่มสร้างเนื้อหาในหัวข้อนี้</p>
            <div class="actions">
                <a class="button primary" href="@AdminRoutes.GrammarRules.CreateForTopic(topic.Id)"><Icon Name="plus" Size="16" /> New Rule / เพิ่มกฎ</a>
            </div>
        </section>
    }
    else
    {
        <section class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Rule / กฎ</th>
                        <th>Sort / ลำดับ</th>
                        <th>Status / สถานะ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rule in rules)
                    {
                        <tr>
                            <td>
                                <strong>@rule.Title</strong>
                                <span class="muted">@rule.StructurePattern</span>
                            </td>
                            <td>@rule.SortOrder</td>
                            <td>
                                <span class="status-badge @(rule.IsActive ? "success" : "muted")">
                                    @(rule.IsActive ? "Active / ใช้งาน" : "Inactive / ปิด")
                                </span>
                            </td>
                            <td class="row-actions">
                                <a class="button small" href="@AdminRoutes.GrammarRules.Detail(rule.Id)" aria-label="View @rule.Title" title="View"><Icon Name="eye" Size="15" /></a>
                                <a class="button small" href="@AdminRoutes.GrammarRules.Edit(rule.Id)" aria-label="Edit @rule.Title" title="Edit"><Icon Name="edit" Size="15" /></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private GrammarTopicDto? topic;
    private IReadOnlyCollection<GrammarRuleDto> rules = [];
    private string? errorMessage;
    private bool isLoading = true;
    private bool notFound;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        notFound = false;
        errorMessage = null;

        try
        {
            topic = await GrammarApiClient.GetTopicAsync(Id, CancellationToken.None);
            if (topic is null)
            {
                notFound = true;
                return;
            }

            rules = (await GrammarApiClient.GetRulesByTopicIdAsync(
                Id,
                isActive: null,
                pageNumber: 1,
                pageSize: 50,
                CancellationToken.None)).Items;
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
