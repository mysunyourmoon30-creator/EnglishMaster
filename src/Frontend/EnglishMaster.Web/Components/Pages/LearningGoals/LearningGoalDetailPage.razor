@page "/learn/goals/{Id:guid}"
@inject ILearningGoalApiClient GoalApiClient

<PageTitle>Learning Goal</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Learning Goals</p>
        <h1>@(goal?.Title ?? "Learning Goal")</h1>
        <p class="page-subtitle">Review progress and manage this goal.</p>
    </div>
    <a class="button secondary" href="/learn/goals"><Icon Name="chevron-left" Size="15" /> Back</a>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (isLoading)
{
    <section class="panel empty-state">
        <strong><Icon Name="spinner" Class="spin" Size="16" /> Loading goal...</strong>
    </section>
}
else if (goal is null)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="search" Size="20" /></span>
        <strong>Goal not found</strong>
        <p>This goal may have been removed. Go back to your goals list.</p>
        <div class="actions">
            <a class="button primary" href="/learn/goals">Back to goals</a>
        </div>
    </section>
}
else
{
    <section class="content-section panel">
        <span class="pill">@goal.Status</span>
        <h2>@goal.GoalType</h2>
        <p>@goal.Description</p>
        <p class="muted">@goal.CurrentValue / @goal.TargetValue @goal.Unit</p>
        <div class="actions">
            <button class="button secondary" type="button" @onclick="PauseAsync">Pause</button>
            <button class="button secondary" type="button" @onclick="ResumeAsync">Resume</button>
            <button class="button primary" type="button" @onclick="CompleteAsync"><Icon Name="quality" Size="15" /> Complete</button>
            <button class="button danger" type="button" @onclick="CancelAsync"><Icon Name="trash" Size="15" /> Cancel</button>
        </div>
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private LearningGoalDto? goal;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            goal = await GoalApiClient.GetByIdAsync(Id, CancellationToken.None);
        }
        catch (ApiRequestException)
        {
            errorMessage = "Goal is unavailable right now.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PauseAsync() => goal = await GoalApiClient.PauseAsync(Id, CancellationToken.None);
    private async Task ResumeAsync() => goal = await GoalApiClient.ResumeAsync(Id, CancellationToken.None);
    private async Task CompleteAsync() => goal = await GoalApiClient.CompleteAsync(Id, CancellationToken.None);
    private async Task CancelAsync() => goal = await GoalApiClient.CancelAsync(Id, CancellationToken.None);
}
