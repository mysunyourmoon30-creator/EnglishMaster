@page "/learn/goals"
@inject ILearningGoalApiClient GoalApiClient

<PageTitle>Learning Goals</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Learning</p>
        <h1>Learning Goals</h1>
        <p class="page-subtitle">Track active and completed learning goals.</p>
    </div>
    <a class="button primary" href="/learn/goals/create"><Icon Name="plus" Size="15" /> Create goal</a>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (isLoading)
{
    <section class="panel empty-state">
        <strong>Loading goals...</strong>
    </section>
}
else
{
    <section class="stat-grid">
        <article class="panel stat-card"><span class="stat-label">Active</span><span class="stat-value">@summary.ActiveCount</span></article>
        <article class="panel stat-card"><span class="stat-label">Completed</span><span class="stat-value">@summary.CompletedCount</span></article>
        <article class="panel stat-card"><span class="stat-label">Paused</span><span class="stat-value">@summary.PausedCount</span></article>
        <article class="panel stat-card"><span class="stat-label">Cancelled</span><span class="stat-value">@summary.CancelledCount</span></article>
    </section>

    <section class="content-section">
        <h2>Active Goals</h2>
        @if (!goals.Any(goal => goal.Status == "Active"))
        {
            <div class="panel empty-state">
                <span class="empty-state-icon"><Icon Name="quality" Size="20" /></span>
                <strong>No active goals yet</strong>
                <p>Set a goal to track your daily study routine and progress.</p>
                <div class="actions">
                    <a class="button primary" href="/learn/goals/create"><Icon Name="plus" Size="15" /> Create goal</a>
                </div>
            </div>
        }
        else
        {
            <div class="card-grid">
                @foreach (var goal in goals.Where(goal => goal.Status == "Active"))
                {
                    <article class="list-card">
                        <span class="pill">@goal.GoalType</span>
                        <h3><a href="/learn/goals/@goal.Id">@goal.Title</a></h3>
                        <p class="muted">@goal.CurrentValue / @goal.TargetValue @goal.Unit</p>
                    </article>
                }
            </div>
        }
    </section>

    <section class="content-section">
        <h2>Completed Goals</h2>
        @if (!goals.Any(goal => goal.Status == "Completed"))
        {
            <div class="panel empty-state">
                <span class="empty-state-icon"><Icon Name="certificate" Size="20" /></span>
                <strong>No completed goals yet</strong>
                <p>Finished goals will appear here once you complete them.</p>
            </div>
        }
        else
        {
            <div class="card-grid">
                @foreach (var goal in goals.Where(goal => goal.Status == "Completed"))
                {
                    <article class="list-card">
                        <span class="pill">@goal.Status</span>
                        <h3><a href="/learn/goals/@goal.Id">@goal.Title</a></h3>
                        <p class="muted">@goal.TargetValue @goal.Unit</p>
                    </article>
                }
            </div>
        }
    </section>
}

@code {
    private LearningGoalSummaryDto summary = new(0, 0, 0, 0);
    private IReadOnlyCollection<LearningGoalDto> goals = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            summary = await GoalApiClient.GetSummaryAsync(CancellationToken.None);
            goals = await GoalApiClient.GetGoalsAsync(CancellationToken.None);
        }
        catch (ApiRequestException)
        {
            errorMessage = "Learning goals are unavailable right now.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
