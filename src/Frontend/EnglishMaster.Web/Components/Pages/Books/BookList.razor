@page "/admin/books"
@rendermode InteractiveServer
@inject IBookApiClient BookApiClient
@inject ICategoriesApiClient CategoriesApiClient
@inject ICourseApiClient CourseApiClient

<PageTitle>Books</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">BOOKS / หนังสือ</p>
        <h1>Books</h1>
        <p class="page-subtitle">Optional reading resources with chapters and linked lessons. / หนังสือเป็นสื่ออ่านเสริม มี chapters และผูกบทเรียนได้</p>
    </div>
    <a class="button primary" href="@AdminRoutes.Books.Create"><Icon Name="plus" Size="16" /> New Book / เพิ่มหนังสือ</a>
</section>

<section class="panel release-note">
    <div>
        <strong>Current role / บทบาทตอนนี้</strong>
        <p class="muted">Books are optional reading material. Keep the 2,500 words, lessons, and practice as the core learning flow.</p>
        <p class="muted">หนังสือเป็นสื่ออ่านเสริม โดย flow หลักยังเป็นคำศัพท์ 2,500 คำ บทเรียน และแบบฝึก</p>
    </div>
</section>

<section class="panel">
    <form class="filters-grid" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label>
            <span>Search / ค้นหา</span>
            <input class="input" @bind="search" @bind:event="oninput" />
        </label>
        <label>
            <span>CEFR</span>
            <select class="input" @bind="cefrLevel">
                <option value="">All / ทุกระดับ</option>
                @foreach (var level in CefrLevels)
                {
                    <option value="@level">@level</option>
                }
            </select>
        </label>
        <label>
            <span>Category / หมวดหมู่</span>
            <select class="input" @bind="categoryId">
                <option value="">All / ทั้งหมด</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </label>
        <label>
            <span>Course / คอร์ส</span>
            <select class="input" @bind="courseId">
                <option value="">All / ทั้งหมด</option>
                @foreach (var course in courses)
                {
                    <option value="@course.Id">@course.Title</option>
                }
            </select>
        </label>
        <label>
            <span>Published / เผยแพร่</span>
            <select class="input" @bind="publishedFilter">
                <option value="">All / ทั้งหมด</option>
                <option value="true">Published / เผยแพร่แล้ว</option>
                <option value="false">Draft / ร่าง</option>
            </select>
        </label>
        <label>
            <span>Status / สถานะ</span>
            <select class="input" @bind="activeFilter">
                <option value="true">Active / ใช้งาน</option>
                <option value="false">Inactive / ปิด</option>
                <option value="">All / ทั้งหมด</option>
            </select>
        </label>
        <label>
            <span>Sort / เรียงตาม</span>
            <select class="input" @bind="sortBy">
                <option value="Title">Title / ชื่อ</option>
                <option value="CreatedAt">Created / วันที่สร้าง</option>
            </select>
        </label>
        <label>
            <span>Page Size / จำนวนต่อหน้า</span>
            <select class="input" @bind="pageSize">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </label>
        <button class="button" type="submit">Search / ค้นหา</button>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}

@if (isLoading)
{
    <p class="muted">Loading books... / กำลังโหลดหนังสือ</p>
}
else if (books.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="book" Size="22" /></span>
        <strong>No books found / ยังไม่พบหนังสือ</strong>
        <p>Books are optional. You can keep using lessons and practice first. / หนังสือเป็นส่วนเสริม ใช้บทเรียนและแบบฝึกก่อนได้</p>
        <div class="actions">
            <a class="button primary" href="@AdminRoutes.Books.Create"><Icon Name="plus" Size="16" /> New Book / เพิ่มหนังสือ</a>
        </div>
    </section>
}
else
{
    <section class="table-wrap">
        <div class="pagination-summary">
            <span class="muted">Page @searchResult.PageNumber of @searchResult.TotalPages / หน้า @searchResult.PageNumber จาก @searchResult.TotalPages</span>
            <span class="status-badge neutral">@searchResult.TotalCount books / @searchResult.TotalCount หนังสือ</span>
        </div>
        <div class="card-grid">
            @foreach (var book in books)
            {
                <div class="entity-card">
                    <a class="entity-card-link" href="@AdminRoutes.Books.Detail(book.Id)">
                        <div class="entity-card-media">
                            @if (book.CoverMedia is not null && !string.IsNullOrWhiteSpace(book.CoverMedia.PublicUrl))
                            {
                                <img src="@book.CoverMedia.PublicUrl" alt="@book.CoverMedia.AltText" />
                            }
                            else
                            {
                                <Icon Name="book" Size="28" />
                            }
                        </div>
                        <div class="entity-card-body">
                            <h3>@book.Title</h3>
                            <span class="muted">@(book.CefrLevel ?? "-") &middot; @book.Chapters.Count chapters / @book.Chapters.Count ตอน</span>
                        </div>
                    </a>
                    <div class="entity-card-footer">
                        <span class="status-badge @(book.IsPublished ? "success" : "warning")">@(book.IsPublished ? "Published / เผยแพร่แล้ว" : "Draft / ร่าง")</span>
                        <span class="row-actions">
                            <a class="button small" href="@AdminRoutes.Books.Detail(book.Id)" aria-label="View @book.Title" title="View"><Icon Name="eye" Size="15" /></a>
                            <a class="button small" href="@AdminRoutes.Books.Edit(book.Id)" aria-label="Edit @book.Title" title="Edit"><Icon Name="edit" Size="15" /></a>
                            <button class="button small danger" type="button" @onclick="() => DeleteAsync(book.Id)" aria-label="Delete @book.Title" title="Delete"><Icon Name="trash" Size="15" /></button>
                        </span>
                    </div>
                </div>
            }
        </div>
        <div class="pagination-row">
            <button class="button small" type="button" disabled="@(!searchResult.HasPreviousPage)" @onclick="PreviousPageAsync">Previous / ก่อนหน้า</button>
            <span class="muted">Page @searchResult.PageNumber / หน้า @searchResult.PageNumber</span>
            <button class="button small" type="button" disabled="@(!searchResult.HasNextPage)" @onclick="NextPageAsync">Next / ถัดไป</button>
        </div>
    </section>
}

@code {
    private static readonly string[] CefrLevels = ["A1", "A2", "B1", "B2", "C1", "C2"];

    private IReadOnlyCollection<BookDto> books = [];
    private IReadOnlyCollection<CategoryDto> categories = [];
    private IReadOnlyCollection<CourseDto> courses = [];
    private BookSearchResponse searchResult = EmptySearchResult();
    private string? search;
    private string? cefrLevel;
    private string? categoryId;
    private string? courseId;
    private string publishedFilter = "";
    private string activeFilter = "true";
    private string sortBy = "Title";
    private int pageNumber = 1;
    private int pageSize = 10;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = (await CategoriesApiClient.SearchAsync(search: null, isActive: true, CancellationToken.None)).Items;
            courses = (await CourseApiClient.SearchAsync(
                new CourseSearchRequest(IsActive: true, PageSize: 100, SortBy: "Title", SortDirection: "Asc"),
                CancellationToken.None)).Items;
        }
        catch (ApiRequestException)
        {
            categories = [];
            courses = [];
        }

        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            searchResult = await BookApiClient.SearchAsync(
                new BookSearchRequest(
                    search,
                    string.IsNullOrWhiteSpace(cefrLevel) ? null : cefrLevel,
                    ParseCategoryFilter(),
                    ParseCourseFilter(),
                    ParsePublishedFilter(),
                    ParseActiveFilter(),
                    pageNumber,
                    pageSize,
                    sortBy,
                    "Asc"),
                CancellationToken.None);
            books = searchResult.Items;
        }
        catch (ApiRequestException exception)
        {
            searchResult = EmptySearchResult();
            books = [];
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (!searchResult.HasPreviousPage)
        {
            return;
        }

        pageNumber--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (!searchResult.HasNextPage)
        {
            return;
        }

        pageNumber++;
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        errorMessage = null;

        try
        {
            await BookApiClient.DeleteAsync(id, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
    }

    private Guid? ParseCategoryFilter()
    {
        return Guid.TryParse(categoryId, out var id) ? id : null;
    }

    private Guid? ParseCourseFilter()
    {
        return Guid.TryParse(courseId, out var id) ? id : null;
    }

    private bool? ParsePublishedFilter()
    {
        return publishedFilter switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
    }

    private bool? ParseActiveFilter()
    {
        return activeFilter switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
    }

    private static BookSearchResponse EmptySearchResult()
    {
        return new BookSearchResponse([], 1, 10, 0, 0, false, false);
    }
}
