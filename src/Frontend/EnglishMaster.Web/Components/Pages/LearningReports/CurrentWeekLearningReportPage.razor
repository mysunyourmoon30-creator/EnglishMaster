@page "/learn/reports/current-week"
@inject ILearningReportApiClient LearningReportApiClient

<PageTitle>Current Week Report</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">REPORTS / รายงาน</p>
        <h1>Current Week Report / รายงานสัปดาห์นี้</h1>
        <p class="page-subtitle">See this week's learning progress. / ดูความคืบหน้าการเรียนของสัปดาห์นี้</p>
    </div>
    <div class="actions">
        <button class="button primary" type="button" @onclick="GenerateAsync"><Icon Name="plus" Size="15" /> Generate / สร้าง</button>
        <a class="button secondary" href="/learn/reports"><Icon Name="revision" Size="15" /> History / ประวัติ</a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (isLoading)
{
    <section class="panel empty-state">
        <strong><Icon Name="spinner" Class="spin" Size="16" /> Loading report... / กำลังโหลดรายงาน</strong>
    </section>
}
else if (report is null)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="report" Size="20" /></span>
        <strong>No report generated for this week yet / ยังไม่มีรายงานสัปดาห์นี้</strong>
        <p>Generate the report to see study minutes, lessons, and quiz performance. / สร้างรายงานเพื่อดูเวลาเรียน บทเรียน และคะแนนแบบฝึก</p>
        <div class="actions">
            <button class="button primary" type="button" @onclick="GenerateAsync"><Icon Name="plus" Size="15" /> Generate / สร้าง</button>
        </div>
    </section>
}
else
{
    <LearningReportSummary Report="report" />
}

@code {
    private WeeklyLearningReportDto? report;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            report = await LearningReportApiClient.GetCurrentWeekAsync(CancellationToken.None);
        }
        catch (ApiRequestException)
        {
            errorMessage = "Current week report is unavailable right now. / ตอนนี้ยังโหลดรายงานสัปดาห์นี้ไม่ได้";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GenerateAsync()
    {
        report = await LearningReportApiClient.GenerateCurrentWeekAsync(CancellationToken.None);
    }
}
