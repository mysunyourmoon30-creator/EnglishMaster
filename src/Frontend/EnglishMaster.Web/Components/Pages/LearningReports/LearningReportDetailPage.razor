@page "/learn/reports/{Id:guid}"
@inject ILearningReportApiClient LearningReportApiClient

<PageTitle>Learning Report / รายงานการเรียน</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">LEARNING REPORTS / รายงานการเรียน</p>
        <h1>Learning Report / รายงานการเรียน</h1>
        <p class="page-subtitle">ดูผลรายสัปดาห์ จุดที่ทำได้ดี และคำแนะนำสำหรับก้าวถัดไป</p>
    </div>
    <div class="actions">
        <button class="button primary" type="button" @onclick="RegenerateAsync"><Icon Name="revision" Size="15" /> Regenerate / สร้างใหม่</button>
        <a class="button secondary" href="/learn/reports"><Icon Name="revision" Size="15" /> History / ประวัติ</a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (isLoading)
{
    <section class="panel empty-state">
        <strong>Loading report... / กำลังโหลดรายงาน</strong>
    </section>
}
else if (report is null)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="search" Size="20" /></span>
        <strong>Report was not found / ไม่พบรายงาน</strong>
        <p>รายงานนี้อาจถูกลบแล้ว กลับไปหน้ารายงานทั้งหมดเพื่อเลือกอีกครั้ง</p>
        <div class="actions">
            <a class="button primary" href="/learn/reports">Back to reports / กลับรายงาน</a>
        </div>
    </section>
}
else
{
    <LearningReportSummary Report="report" />
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private WeeklyLearningReportDto? report;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            report = await LearningReportApiClient.GetByIdAsync(Id, CancellationToken.None);
        }
        catch (ApiRequestException)
        {
            errorMessage = "Learning report is unavailable right now. / ตอนนี้ยังโหลดรายงานไม่ได้";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RegenerateAsync()
    {
        report = await LearningReportApiClient.RegenerateAsync(Id, CancellationToken.None);
    }
}
