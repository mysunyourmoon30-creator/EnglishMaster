@page "/learn/reports"
@inject ILearningReportApiClient LearningReportApiClient

<PageTitle>Learning Reports</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">REPORTS / รายงาน</p>
        <h1>Learning Reports</h1>
        <p class="page-subtitle">Review weekly progress, study time, active days, and quiz performance. / ดูความคืบหน้ารายสัปดาห์ เวลาเรียน วันที่เรียน และคะแนนแบบฝึก</p>
    </div>
    <div class="actions">
        <a class="button primary" href="/learn/reports/current-week"><Icon Name="report" Size="15" /> Current Week / สัปดาห์นี้</a>
        <button class="button secondary" type="button" @onclick="GenerateAsync"><Icon Name="plus" Size="15" /> Generate / สร้างรายงาน</button>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (isLoading)
{
    <section class="panel empty-state">
        <strong>Loading reports... / กำลังโหลดรายงาน</strong>
    </section>
}
else if (reports.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="report" Size="20" /></span>
        <strong>No weekly reports yet / ยังไม่มีรายงานรายสัปดาห์</strong>
        <p>Generate this week's report to see study minutes, active days, and quiz performance. / สร้างรายงานสัปดาห์นี้เพื่อดูเวลาเรียน วันที่เรียน และคะแนนแบบฝึก</p>
        <div class="actions">
            <button class="button primary" type="button" @onclick="GenerateAsync"><Icon Name="plus" Size="15" /> Generate / สร้างรายงาน</button>
        </div>
    </section>
}
else
{
    <div class="card-grid">
        @foreach (var report in reports)
        {
            <article class="list-card">
                <span class="pill">@report.Status</span>
                <h3>@report.WeekStartDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) - @report.WeekEndDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</h3>
                <p class="muted">@report.TotalStudyMinutes minutes / นาที - @report.ActiveStudyDays active days / วันที่เรียน - @report.AverageQuizScore.ToString("0.#")% quiz average / คะแนนเฉลี่ย</p>
                <a class="button secondary" href="/learn/reports/@report.Id">Open / เปิดดู</a>
            </article>
        }
    </div>
}

@code {
    private IReadOnlyCollection<WeeklyLearningReportDto> reports = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            reports = await LearningReportApiClient.GetHistoryAsync(null, null, CancellationToken.None);
        }
        catch (ApiRequestException)
        {
            errorMessage = "Learning reports are unavailable right now. / ตอนนี้ยังโหลดรายงานไม่ได้";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GenerateAsync()
    {
        await LearningReportApiClient.GenerateCurrentWeekAsync(CancellationToken.None);
        await LoadAsync();
    }
}
