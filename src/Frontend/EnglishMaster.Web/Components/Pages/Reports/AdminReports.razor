@page "/admin/reports"
@rendermode InteractiveServer
@inject IReportsApiClient ReportsApiClient

<PageTitle>Admin Reports</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">ADMIN REPORTS / รายงานผู้ดูแล</p>
        <h1>Reports</h1>
        <p class="page-subtitle">Content status, quiz analytics, learning progress, and recent activity. / สถานะเนื้อหา ผลแบบฝึก ความคืบหน้าผู้เรียน และกิจกรรมล่าสุด</p>
    </div>
</section>

@if (isLoading)
{
    <div class="panel loading-indicator"><Icon Name="spinner" Class="spin" Size="16" /><span>Loading reports... / กำลังโหลดรายงาน</span></div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (dashboard is not null && learning is not null)
{
    <section class="stat-grid">
        <div class="panel stat-card">
            <Icon Name="users" Size="18" />
            <span class="stat-label">Students / ผู้เรียน</span>
            <span class="stat-value">@dashboard.Overview.TotalStudents</span>
        </div>
        <div class="panel stat-card">
            <Icon Name="word" Size="18" />
            <span class="stat-label">Words / คำศัพท์</span>
            <span class="stat-value">@dashboard.Overview.TotalWords</span>
        </div>
        <div class="panel stat-card">
            <Icon Name="lesson" Size="18" />
            <span class="stat-label">Lessons / บทเรียน</span>
            <span class="stat-value">@dashboard.Overview.TotalLessons</span>
        </div>
        <div class="panel stat-card">
            <Icon Name="quiz" Size="18" />
            <span class="stat-label">Quizzes / แบบฝึก</span>
            <span class="stat-value">@dashboard.Overview.TotalQuizzes</span>
        </div>
    </section>

    <section class="content-grid">
        <article class="panel">
            <h2><Icon Name="quality" Size="17" /> Content Status / สถานะเนื้อหา</h2>
            <dl class="metric-list">
                <dt>Published lessons / บทเรียนเผยแพร่แล้ว</dt>
                <dd>@dashboard.ContentStatus.PublishedLessons</dd>
                <dt>Draft lessons / บทเรียนร่าง</dt>
                <dd>@dashboard.ContentStatus.DraftLessons</dd>
                <dt>Published courses / คอร์สเผยแพร่แล้ว</dt>
                <dd>@dashboard.ContentStatus.PublishedCourses</dd>
                <dt>Published books / หนังสือเผยแพร่แล้ว</dt>
                <dd>@dashboard.ContentStatus.PublishedBooks</dd>
                <dt>Published quizzes / แบบฝึกเผยแพร่แล้ว</dt>
                <dd>@dashboard.ContentStatus.PublishedQuizzes</dd>
            </dl>
        </article>

        <article class="panel">
            <h2><Icon Name="quiz" Size="17" /> Quiz Analytics / ผลแบบฝึก</h2>
            <dl class="metric-list">
                <dt>Total attempts / จำนวนครั้งที่ทำ</dt>
                <dd>@dashboard.QuizAnalytics.TotalAttempts</dd>
                <dt>Average score / คะแนนเฉลี่ย</dt>
                <dd>@dashboard.QuizAnalytics.AverageScore</dd>
                <dt>Passed / ผ่าน</dt>
                <dd>@dashboard.QuizAnalytics.PassedCount</dd>
                <dt>Failed / ไม่ผ่าน</dt>
                <dd>@dashboard.QuizAnalytics.FailedCount</dd>
            </dl>
        </article>

        <article class="panel">
            <h2><Icon Name="analytics" Size="17" /> Learning Progress / ความคืบหน้าการเรียน</h2>
            <dl class="metric-list">
                <dt>Course started / เริ่มคอร์ส</dt>
                <dd>@learning.CourseProgress.StartedCount</dd>
                <dt>Course completed / จบคอร์ส</dt>
                <dd>@learning.CourseProgress.CompletedCount</dd>
                <dt>Book started / เริ่มหนังสือ</dt>
                <dd>@learning.BookProgress.StartedCount</dd>
                <dt>Book completed / จบหนังสือ</dt>
                <dd>@learning.BookProgress.CompletedCount</dd>
            </dl>
        </article>

        <article class="panel">
            <h2><Icon Name="revision" Size="17" /> Recent Activity / กิจกรรมล่าสุด</h2>
            @if (dashboard.RecentActivity.Count == 0)
            {
                <div class="empty-state left-aligned">
                    <p>No recent activity. / ยังไม่มีกิจกรรมล่าสุด</p>
                </div>
            }
            else
            {
                <ul class="plain-list">
                    @foreach (var item in dashboard.RecentActivity)
                    {
                        <li>
                            <strong>@item.Type</strong>
                            <span>@item.Title</span>
                            <span class="muted">@item.OccurredAt.LocalDateTime.ToString("g", CultureInfo.InvariantCulture)</span>
                        </li>
                    }
                </ul>
            }
        </article>
    </section>
}

@code {
    private AdminDashboardSummaryDto? dashboard;
    private LearningProgressSummaryDto? learning;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dashboardTask = ReportsApiClient.GetAdminDashboardSummaryAsync(CancellationToken.None);
            var learningTask = ReportsApiClient.GetLearningProgressSummaryAsync(CancellationToken.None);
            await Task.WhenAll(dashboardTask, learningTask);
            dashboard = dashboardTask.Result;
            learning = learningTask.Result;
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
