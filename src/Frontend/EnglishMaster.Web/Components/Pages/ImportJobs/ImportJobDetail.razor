@page "/admin/import-jobs/{Id:guid}"
@rendermode InteractiveServer
@inject IImportJobApiClient ImportJobApiClient

<PageTitle>Import Job</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Import Jobs</p>
        <h1>@(job is null ? "Import Job" : $"Import Job · {job.ImportType}")</h1>
        <p class="page-subtitle">Validate, run, and manage the lifecycle of this import job.</p>
    </div>
    <a class="button" href="@AdminRoutes.ImportJobs.Index">Back to Import Jobs</a>
</section>

@if (isLoading)
{
    <div class="panel loading-indicator"><Icon Name="spinner" Class="spin" Size="16" /><span>Loading import job...</span></div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (job is not null)
{
    <section class="panel">
        <div class="detail-grid">
            <div class="detail-item"><span class="muted">Type</span><strong>@job.ImportType</strong></div>
            <div class="detail-item"><span class="muted">Format</span><strong>@job.Format</strong></div>
            <div class="detail-item"><span class="muted">Status</span><strong>@job.Status</strong></div>
        </div>
    </section>

    <h3 class="detail-section-heading">Row Summary</h3>
    <section class="stat-grid">
        <div class="panel stat-card">
            <Icon Name="import" Size="18" />
            <span class="stat-label">Total Rows</span>
            <span class="stat-value">@job.TotalRows</span>
        </div>
        <div class="panel stat-card">
            <Icon Name="import" Size="18" />
            <span class="stat-label">Valid</span>
            <span class="stat-value">@job.ValidRows</span>
        </div>
        <div class="panel stat-card">
            <Icon Name="import" Size="18" />
            <span class="stat-label">Invalid</span>
            <span class="stat-value">@job.InvalidRows</span>
        </div>
        <div class="panel stat-card">
            <Icon Name="import" Size="18" />
            <span class="stat-label">Imported</span>
            <span class="stat-value">@job.ImportedRows</span>
        </div>
        <div class="panel stat-card">
            <Icon Name="import" Size="18" />
            <span class="stat-label">Failed</span>
            <span class="stat-value">@job.FailedRows</span>
        </div>
    </section>

    <section class="panel">
        <div class="form-actions">
            <button class="button" @onclick="ValidateAsync" disabled="@isSaving">Validate</button>
            <button class="button" @onclick="ConfirmAsync" disabled="@isSaving">Confirm</button>
            <button class="button primary" @onclick="RunAsync" disabled="@isSaving">Run</button>
            <button class="button secondary" @onclick="CancelAsync" disabled="@isSaving">Cancel</button>
            <button class="button secondary" @onclick="RollbackAsync" disabled="@isSaving">Rollback</button>
            <a class="button secondary" href="@AdminRoutes.ImportJobs.Rows(job.Id)"><Icon Name="eye" Size="15" /> Rows</a>
            <a class="button secondary" href="@AdminRoutes.ImportJobs.Errors(job.Id)"><Icon Name="eye" Size="15" /> Errors</a>
        </div>
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ImportJobDto? job;
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            job = await ImportJobApiClient.GetAsync(Id, CancellationToken.None);
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task ValidateAsync() => SaveAsync(() => ImportJobApiClient.ValidateAsync(Id, CancellationToken.None));
    private Task ConfirmAsync() => SaveAsync(() => ImportJobApiClient.ConfirmAsync(Id, CancellationToken.None));
    private Task RunAsync() => SaveAsync(() => ImportJobApiClient.RunAsync(Id, CancellationToken.None));
    private Task CancelAsync() => SaveAsync(() => ImportJobApiClient.CancelAsync(Id, CancellationToken.None));
    private Task RollbackAsync() => SaveAsync(() => ImportJobApiClient.RollbackAsync(Id, CancellationToken.None));

    private async Task SaveAsync(Func<Task<ImportJobDto>> action)
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            job = await action();
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
