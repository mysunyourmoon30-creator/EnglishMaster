@page "/admin/import-jobs"
@rendermode InteractiveServer
@inject IImportJobApiClient ImportJobApiClient

<PageTitle>Import Jobs</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Import Jobs</p>
        <h1>Import Jobs</h1>
        <p class="page-subtitle">Track content imports from upload through validation to completion.</p>
    </div>
    <a class="button primary" href="@AdminRoutes.ImportJobs.Upload"><Icon Name="import" Size="16" /> Upload</a>
</section>

@if (isLoading)
{
    <div class="panel loading-indicator"><Icon Name="spinner" Class="spin" Size="16" /><span>Loading import jobs...</span></div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (jobs.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="import" Size="22" /></span>
        <strong>No import jobs found</strong>
        <p>Upload a file to start importing content.</p>
        <div class="actions">
            <a class="button primary" href="@AdminRoutes.ImportJobs.Upload"><Icon Name="import" Size="16" /> Upload</a>
        </div>
    </section>
}
else
{
    <section class="table-wrap">
        <table class="data-table">
            <thead>
                <tr><th>Type</th><th>Format</th><th>Status</th><th>Rows</th><th>Requested</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var job in jobs)
                {
                    <tr>
                        <td>@job.ImportType</td>
                        <td>@job.Format</td>
                        <td>@job.Status</td>
                        <td>@job.ValidRows valid / @job.InvalidRows invalid</td>
                        <td>@job.RequestedBy at @job.RequestedAt.LocalDateTime.ToString("g", CultureInfo.InvariantCulture)</td>
                        <td class="row-actions"><a class="button small" href="@AdminRoutes.ImportJobs.Detail(job.Id)" aria-label="View import job" title="View"><Icon Name="eye" Size="15" /></a></td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private IReadOnlyCollection<ImportJobDto> jobs = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            jobs = (await ImportJobApiClient.SearchAsync(null, null, null, CancellationToken.None)).Items;
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
