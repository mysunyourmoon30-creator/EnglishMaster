@page "/admin/import-jobs/{Id:guid}/rows"
@rendermode InteractiveServer
@inject IImportJobApiClient ImportJobApiClient

<PageTitle>Import Rows</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Import Jobs</p>
        <h1>Import Rows</h1>
        <p class="page-subtitle">Row-by-row status for this import job.</p>
    </div>
    <a class="button" href="@AdminRoutes.ImportJobs.Detail(Id)">Back to Import Job</a>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (rows.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="import" Size="22" /></span>
        <strong>No rows yet</strong>
        <p>Rows will appear here after the import job has been validated or run.</p>
    </section>
}
else
{
    <section class="table-wrap">
        <table class="data-table">
            <thead><tr><th>Row</th><th>Status</th><th>Error</th><th>Raw</th></tr></thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr><td>@row.RowNumber</td><td>@row.Status</td><td>@row.ErrorMessage</td><td>@row.RawDataJson</td></tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private IReadOnlyCollection<ImportJobRowDto> rows = [];
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            rows = await ImportJobApiClient.GetRowsAsync(Id, CancellationToken.None);
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
    }
}
