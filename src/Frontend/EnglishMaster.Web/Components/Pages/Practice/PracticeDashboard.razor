@page "/learn/practice"
@inject IPracticeApiClient PracticeApiClient
@inject NavigationManager NavigationManager

<PageTitle>Practice / ฝึกทบทวน</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">PRACTICE / ฝึกทบทวน</p>
        <h1>Practice Today</h1>
        <p class="page-subtitle">Start with a short review. The system picks words that are due, then you rate how well you remember them. / เริ่มจากชุดสั้น ๆ ระบบจะเลือกคำที่ควรทบทวน แล้วให้คุณกดประเมินว่า จำไม่ได้ ยาก พอได้ หรือง่าย</p>
    </div>
    <div class="actions">
        <button class="button" type="button" disabled="@isBusy" @onclick="GenerateAsync">
            <Icon Name="plus" Size="15" /> Prepare items / เตรียมคำฝึก
        </button>
        <button class="button primary" type="button" disabled="@isBusy" @onclick="StartAsync">
            <Icon Name="quiz" Size="15" /> Start practice / เริ่มฝึก
        </button>
        <a class="button secondary" href="/learn/practice/history"><Icon Name="revision" Size="15" /> History / ประวัติ</a>
    </div>
</section>

<section class="panel release-note">
    <div>
        <strong>How to use / วิธีใช้</strong>
        <p class="muted">Press Start practice, read each prompt, check the answer, then choose the button that matches your memory.</p>
        <p class="muted">กดเริ่มฝึก อ่านคำถามทีละข้อ ดูคำตอบ แล้วเลือกตามความจำจริง: Again = ยังจำไม่ได้, Hard = ยาก, Good = พอได้, Easy = ง่าย</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (isLoading)
{
    <section class="panel empty-state">
        <strong><Icon Name="spinner" Class="spin" Size="16" /> Loading practice... / กำลังโหลดรายการฝึก</strong>
        <span class="muted">Please wait while we check what should be reviewed today. / รอสักครู่ ระบบกำลังดูว่าคำไหนควรทบทวนวันนี้</span>
    </section>
}
else
{
    <section class="stat-grid">
        <article class="panel stat-card"><Icon Name="quiz" Size="18" /><span class="stat-label">Due today / วันนี้</span><span class="stat-value">@summary.DueTodayCount</span></article>
        <article class="panel stat-card"><Icon Name="plus" Size="18" /><span class="stat-label">New / คำใหม่</span><span class="stat-value">@summary.NewCount</span></article>
        <article class="panel stat-card"><Icon Name="revision" Size="18" /><span class="stat-label">Reviewing / กำลังทบทวน</span><span class="stat-value">@summary.ReviewingCount</span></article>
        <article class="panel stat-card"><Icon Name="quality" Size="18" /><span class="stat-label">Mastered / จำได้แล้ว</span><span class="stat-value">@summary.MasteredCount</span></article>
    </section>

    <section class="content-section">
        <div class="section-header-row">
            <div>
                <h2>Ready to Practice / พร้อมฝึก</h2>
                <p class="muted">If no items are ready yet, start practice and the system will prepare a starter set for you. / ถ้ายังไม่มีรายการฝึก ให้กดเริ่มฝึกได้เลย ระบบจะเตรียมชุดเริ่มต้นให้อัตโนมัติ</p>
            </div>
            <a class="button secondary" href="/learn/study-plan">Study Plan / แผนเรียน</a>
        </div>

        @if (dueItems.Count == 0)
        {
            <section class="panel study-empty">
                <div>
                    <p class="eyebrow">STARTER SET / ชุดเริ่มต้น</p>
                    <h2>No practice items yet / ยังไม่มีคำให้ฝึก</h2>
                    <p class="muted">Start practice and the system will pick useful words from the 2,500 common word set. / กดเริ่มฝึก ระบบจะเลือกคำพื้นฐานจากชุด 2,500 คำยอดนิยมมาให้ลองก่อน</p>
                </div>
                <div class="study-quick-actions">
                    <button class="button primary" type="button" disabled="@isBusy" @onclick="StartAsync">
                        Start starter practice / เริ่มชุดฝึก
                    </button>
                    <button class="button secondary" type="button" disabled="@isBusy" @onclick="GenerateAsync">
                        Prepare only / เตรียมอย่างเดียว
                    </button>
                </div>
            </section>
        }
        else
        {
            <div class="card-grid">
                @foreach (var item in dueItems)
                {
                    <article class="list-card">
                        <div class="list-card-badges">
                            <span class="pill">@GetPracticeTypeLabel(item.PracticeType)</span>
                            <span class="pill">@GetStatusLabel(item.Status)</span>
                        </div>
                        <h3>@GetContentTypeLabel(item.ContentType)</h3>
                        <p class="muted">Reviewed @item.ReviewCount times / ทบทวนแล้ว @item.ReviewCount ครั้ง · Next interval @item.CurrentIntervalDays days / รอบถัดไป @item.CurrentIntervalDays วัน</p>
                    </article>
                }
            </div>
        }
    </section>
}

@code {
    private PracticeSummaryDto summary = new(0, 0, 0, 0);
    private IReadOnlyCollection<PracticeItemDto> dueItems = [];
    private bool isLoading = true;
    private bool isBusy;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            summary = await PracticeApiClient.GetSummaryAsync(CancellationToken.None);
            dueItems = await PracticeApiClient.GetDueAsync(CancellationToken.None);
        }
        catch (ApiRequestException)
        {
            errorMessage = "Practice is unavailable right now. / ตอนนี้ยังโหลดหน้าฝึกไม่ได้";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GenerateAsync()
    {
        await RunBusyAsync(async () =>
        {
            await PracticeApiClient.GenerateAsync(CancellationToken.None);
            await LoadAsync();
        });
    }

    private async Task StartAsync()
    {
        await RunBusyAsync(async () =>
        {
            if (dueItems.Count == 0)
            {
                await PracticeApiClient.GenerateAsync(CancellationToken.None);
            }

            var session = await PracticeApiClient.StartSessionAsync(CancellationToken.None);
            NavigationManager.NavigateTo($"/learn/practice/session/{session.Id}");
        });
    }

    private async Task RunBusyAsync(Func<Task> action)
    {
        errorMessage = null;
        isBusy = true;
        try
        {
            await action();
        }
        catch (ApiRequestException)
        {
            errorMessage = "Practice action failed. Please try again. / ทำรายการฝึกไม่สำเร็จ ลองใหม่อีกครั้ง";
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string GetContentTypeLabel(string value) => value.ToLowerInvariant() switch
    {
        "word" => "Word / คำศัพท์",
        "quiz" => "Quiz / แบบฝึก",
        _ => value
    };

    private static string GetPracticeTypeLabel(string value) => value.ToLowerInvariant() switch
    {
        "recall" => "Recall / นึกคำตอบ",
        "recognition" => "Recognition / เลือกคำตอบ",
        "typing" => "Typing / พิมพ์ตอบ",
        _ => value
    };

    private static string GetStatusLabel(string value) => value.ToLowerInvariant() switch
    {
        "new" => "New / ใหม่",
        "reviewing" => "Reviewing / ทบทวน",
        "mastered" => "Mastered / จำได้แล้ว",
        _ => value
    };
}
