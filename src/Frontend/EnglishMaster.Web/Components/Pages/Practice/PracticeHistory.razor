@page "/learn/practice/history"
@inject IPracticeApiClient PracticeApiClient

<PageTitle>Practice History / ประวัติการฝึก</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">PRACTICE HISTORY / ประวัติการฝึก</p>
        <h1>Recent Practice</h1>
        <p class="page-subtitle">See recent sessions, completed items, remembered items, and words that still need review. / ดูรอบฝึกล่าสุด จำนวนข้อที่ทำได้ และข้อที่ยังต้องทบทวน</p>
    </div>
    <a class="button secondary" href="/learn/practice"><Icon Name="chevron-left" Size="15" /> Back / กลับ</a>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (isLoading)
{
    <section class="panel empty-state">
        <strong><Icon Name="spinner" Class="spin" Size="16" /> Loading history... / กำลังโหลดประวัติ</strong>
    </section>
}
else if (sessions.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="revision" Size="20" /></span>
        <strong>No practice sessions yet / ยังไม่มีประวัติการฝึก</strong>
        <p>Your finished practice sessions will appear here. / เมื่อฝึกจบรอบ ผลจะแสดงที่นี่</p>
        <div class="actions">
            <a class="button primary" href="/learn/practice">Start practice / เริ่มฝึก</a>
        </div>
    </section>
}
else
{
    <section class="content-list">
        @foreach (var item in sessions)
        {
            <article class="list-card">
                <div class="list-card-badges">
                    <span class="pill">@GetStatusLabel(item.Status)</span>
                    <span class="pill">@item.CompletedItems / @item.TotalItems done</span>
                </div>
                <h2>@item.StartedAt.LocalDateTime.ToString("g", CultureInfo.InvariantCulture)</h2>
                <p class="muted">@item.CorrectItems remembered / จำได้ @item.CorrectItems ข้อ · @item.IncorrectItems need review / ต้องทบทวน @item.IncorrectItems ข้อ</p>
            </article>
        }
    </section>
}

@code {
    private IReadOnlyCollection<PracticeSessionDto> sessions = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sessions = await PracticeApiClient.GetHistoryAsync(CancellationToken.None);
        }
        catch (ApiRequestException)
        {
            errorMessage = "Practice history is unavailable. / เปิดประวัติการฝึกไม่ได้";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetStatusLabel(string value) => value.ToLowerInvariant() switch
    {
        "started" => "Started / กำลังฝึก",
        "completed" => "Completed / จบแล้ว",
        "cancelled" => "Cancelled / ยกเลิก",
        _ => value
    };
}
