@page "/admin/quizzes"
@rendermode InteractiveServer
@inject IQuizApiClient QuizApiClient
@inject ICategoriesApiClient CategoriesApiClient
@inject ILessonApiClient LessonApiClient
@inject ICourseApiClient CourseApiClient
@inject IBookApiClient BookApiClient

<PageTitle>Quizzes</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">QUIZZES / แบบฝึก</p>
        <h1>Quiz Management</h1>
        <p class="page-subtitle">Create practice quizzes, connect them to lessons, and publish them to the learner page. / สร้างแบบฝึก เชื่อมกับบทเรียน แล้วเผยแพร่ให้ผู้เรียนใช้งาน</p>
    </div>
    <div class="actions">
        <a class="button" href="/learn/practice">Learner practice / หน้าฝึกของผู้เรียน</a>
        <a class="button primary" href="@AdminRoutes.Quizzes.Create"><Icon Name="plus" Size="16" /> New Quiz / เพิ่มแบบฝึก</a>
    </div>
</section>

<section class="panel release-note">
    <div>
        <strong>Recommended flow / ลำดับที่แนะนำ</strong>
        <p class="muted">1. Create quiz -> 2. Add questions and choices -> 3. Check learner link -> 4. Publish when ready.</p>
        <p class="muted">สร้างแบบฝึก -> เพิ่มคำถามและตัวเลือก -> ตรวจหน้าผู้เรียน -> เผยแพร่เมื่อพร้อม</p>
    </div>
</section>

<section class="stat-grid quiz-overview" aria-label="Quiz overview">
    <div class="panel stat-card">
        <span class="stat-label">Total / ทั้งหมด</span>
        <strong class="stat-value">@searchResult.TotalCount</strong>
    </div>
    <div class="panel stat-card status-ok">
        <span class="stat-label">Published / เผยแพร่แล้ว</span>
        <strong class="stat-value">@publishedCount</strong>
    </div>
    <div class="panel stat-card">
        <span class="stat-label">Draft / ฉบับร่าง</span>
        <strong class="stat-value">@draftCount</strong>
    </div>
    <div class="panel stat-card">
        <span class="stat-label">Questions / จำนวนคำถาม</span>
        <strong class="stat-value">@questionCount</strong>
    </div>
</section>

<section class="panel filter-panel">
    <div class="section-header-row">
        <div>
            <h2>Find quizzes / ค้นหาแบบฝึก</h2>
            <p class="muted">Use the filters that matter now. / เลือกตัวกรองเท่าที่จำเป็นก่อน</p>
        </div>
        <button class="button small" type="button" @onclick="ClearFiltersAsync">Clear / ล้าง</button>
    </div>
    <form class="filters-grid" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label>
            <span>Search / ค้นหา</span>
            <input class="input" placeholder="Title, lesson, or summary / ชื่อ บทเรียน หรือคำอธิบาย" @bind="search" @bind:event="oninput" />
        </label>
        <label>
            <span>CEFR</span>
            <select class="input" @bind="cefrLevel">
                <option value="">All / ทุกระดับ</option>
                @foreach (var level in CefrLevels)
                {
                    <option value="@level">@level</option>
                }
            </select>
        </label>
        <label>
            <span>Category / หมวดหมู่</span>
            <select class="input" @bind="categoryId">
                <option value="">All / ทั้งหมด</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </label>
        <label>
            <span>Lesson / บทเรียน</span>
            <select class="input" @bind="lessonId">
                <option value="">All / ทั้งหมด</option>
                @foreach (var lesson in lessons)
                {
                    <option value="@lesson.Id">@lesson.Title</option>
                }
            </select>
        </label>
        <label>
            <span>Course / คอร์ส</span>
            <select class="input" @bind="courseId">
                <option value="">All / ทั้งหมด</option>
                @foreach (var course in courses)
                {
                    <option value="@course.Id">@course.Title</option>
                }
            </select>
        </label>
        <label>
            <span>Book / หนังสือ</span>
            <select class="input" @bind="bookId">
                <option value="">All / ทั้งหมด</option>
                @foreach (var book in books)
                {
                    <option value="@book.Id">@book.Title</option>
                }
            </select>
        </label>
        <label>
            <span>Published / การเผยแพร่</span>
            <select class="input" @bind="publishedFilter">
                <option value="">All / ทั้งหมด</option>
                <option value="true">Published / เผยแพร่แล้ว</option>
                <option value="false">Draft / ฉบับร่าง</option>
            </select>
        </label>
        <label>
            <span>Status / สถานะ</span>
            <select class="input" @bind="activeFilter">
                <option value="true">Active / ใช้งาน</option>
                <option value="false">Inactive / ปิดใช้งาน</option>
                <option value="">All / ทั้งหมด</option>
            </select>
        </label>
        <label>
            <span>Sort / เรียงตาม</span>
            <select class="input" @bind="sortBy">
                <option value="Title">Title / ชื่อ</option>
                <option value="CreatedAt">Created / วันที่สร้าง</option>
            </select>
        </label>
        <label>
            <span>Page Size / จำนวนต่อหน้า</span>
            <select class="input" @bind="pageSize">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </label>
        <button class="button filter-submit" type="submit">Search / ค้นหา</button>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}

@if (isLoading)
{
    <section class="panel empty-state" aria-live="polite">
        <strong>Loading quizzes...</strong>
        <p class="muted">กำลังโหลดแบบทดสอบ</p>
    </section>
}
else if (quizzes.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="quiz" Size="22" /></span>
        <strong>No quizzes found / ไม่พบแบบฝึก</strong>
        <p>Try clearing filters or create a new quiz. / ลองล้างตัวกรอง หรือเพิ่มแบบฝึกใหม่</p>
        <div class="actions">
            <button class="button" type="button" @onclick="ClearFiltersAsync">Clear filters / ล้างตัวกรอง</button>
            <a class="button primary" href="@AdminRoutes.Quizzes.Create"><Icon Name="plus" Size="16" /> New Quiz / เพิ่มแบบฝึก</a>
        </div>
    </section>
}
else
{
    <section class="table-wrap">
        <div class="pagination-summary">
            <span class="muted">Page @searchResult.PageNumber of @searchResult.TotalPages / หน้า @searchResult.PageNumber จาก @searchResult.TotalPages</span>
            <span class="pill">@searchResult.TotalCount quizzes / @searchResult.TotalCount รายการ</span>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>CEFR</th>
                    <th>Category</th>
                    <th>Lesson</th>
                    <th>Questions / คำถาม</th>
                    <th>Learner page / หน้าผู้เรียน</th>
                    <th>Published / เผยแพร่</th>
                    <th>Status / สถานะ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var quiz in quizzes)
                {
                    <tr>
                        <td>
                            <strong>@quiz.Title</strong>
                            <span class="muted">@quiz.Summary</span>
                        </td>
                        <td>@(quiz.CefrLevel ?? "-")</td>
                        <td>@(quiz.Category?.Name ?? "-")</td>
                        <td>@(quiz.Lesson?.Title ?? "-")</td>
                        <td>@quiz.Questions.Count</td>
                        <td>
                            @if (quiz.IsPublished && !string.IsNullOrWhiteSpace(quiz.Slug))
                            {
                                <a class="button small" href="@PublicQuizUrl(quiz.Slug)">Open / เปิดดู</a>
                            }
                            else
                            {
                                <span class="muted">Publish first / เผยแพร่ก่อน</span>
                            }
                        </td>
                        <td><span class="@GetPublishedBadgeClass(quiz.IsPublished)">@(quiz.IsPublished ? "Published / เผยแพร่แล้ว" : "Draft / ร่าง")</span></td>
                        <td><span class="@GetActiveBadgeClass(quiz.IsActive)">@(quiz.IsActive ? "Active / ใช้งาน" : "Inactive / ปิด")</span></td>
                        <td class="row-actions">
                            <a class="button small" href="@AdminRoutes.Quizzes.Detail(quiz.Id)" aria-label="View @quiz.Title" title="View / ดู"><Icon Name="eye" Size="15" /></a>
                            <a class="button small" href="@AdminRoutes.Quizzes.Edit(quiz.Id)" aria-label="Edit @quiz.Title" title="Edit / แก้ไข"><Icon Name="edit" Size="15" /></a>
                            <button class="button small danger" type="button" @onclick="() => DeleteAsync(quiz.Id)" aria-label="Delete @quiz.Title" title="Delete / ลบ"><Icon Name="trash" Size="15" /></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="pagination-row">
            <button class="button small" type="button" disabled="@(!searchResult.HasPreviousPage)" @onclick="PreviousPageAsync">Previous / ก่อนหน้า</button>
            <span class="muted">Page @searchResult.PageNumber / หน้า @searchResult.PageNumber</span>
            <button class="button small" type="button" disabled="@(!searchResult.HasNextPage)" @onclick="NextPageAsync">Next / ถัดไป</button>
        </div>
    </section>
}

@code {
    private static readonly string[] CefrLevels = ["A1", "A2", "B1", "B2", "C1", "C2"];

    private IReadOnlyCollection<QuizDto> quizzes = [];
    private IReadOnlyCollection<CategoryDto> categories = [];
    private IReadOnlyCollection<LessonDto> lessons = [];
    private IReadOnlyCollection<CourseDto> courses = [];
    private IReadOnlyCollection<BookDto> books = [];
    private QuizSearchResponse searchResult = EmptySearchResult();
    private string? search;
    private string? cefrLevel;
    private string? categoryId;
    private string? lessonId;
    private string? courseId;
    private string? bookId;
    private string publishedFilter = "";
    private string activeFilter = "true";
    private string sortBy = "Title";
    private int pageNumber = 1;
    private int pageSize = 10;
    private string? errorMessage;
    private bool isLoading = true;
    private int publishedCount => quizzes.Count(quiz => quiz.IsPublished);
    private int draftCount => quizzes.Count(quiz => !quiz.IsPublished);
    private int questionCount => quizzes.Sum(quiz => quiz.Questions.Count);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = (await CategoriesApiClient.SearchAsync(search: null, isActive: true, CancellationToken.None)).Items;
            lessons = (await LessonApiClient.SearchAsync(
                new LessonSearchRequest(IsActive: true, PageSize: 100, SortBy: "Title", SortDirection: "Asc"),
                CancellationToken.None)).Items;
            courses = (await CourseApiClient.SearchAsync(
                new CourseSearchRequest(IsActive: true, PageSize: 100, SortBy: "Title", SortDirection: "Asc"),
                CancellationToken.None)).Items;
            books = (await BookApiClient.SearchAsync(
                new BookSearchRequest(IsActive: true, PageSize: 100, SortBy: "Title", SortDirection: "Asc"),
                CancellationToken.None)).Items;
        }
        catch (ApiRequestException)
        {
            categories = [];
            lessons = [];
            courses = [];
            books = [];
        }

        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        search = null;
        cefrLevel = null;
        categoryId = null;
        lessonId = null;
        courseId = null;
        bookId = null;
        publishedFilter = "";
        activeFilter = "true";
        sortBy = "Title";
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            searchResult = await QuizApiClient.SearchAsync(
                new QuizSearchRequest(
                    search,
                    string.IsNullOrWhiteSpace(cefrLevel) ? null : cefrLevel,
                    ParseGuidFilter(categoryId),
                    ParseGuidFilter(lessonId),
                    ParseGuidFilter(courseId),
                    ParseGuidFilter(bookId),
                    ParsePublishedFilter(),
                    ParseActiveFilter(),
                    pageNumber,
                    pageSize,
                    sortBy,
                    "Asc"),
                CancellationToken.None);
            quizzes = searchResult.Items;
        }
        catch (ApiRequestException exception)
        {
            searchResult = EmptySearchResult();
            quizzes = [];
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (!searchResult.HasPreviousPage)
        {
            return;
        }

        pageNumber--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (!searchResult.HasNextPage)
        {
            return;
        }

        pageNumber++;
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        errorMessage = null;

        try
        {
            await QuizApiClient.DeleteAsync(id, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
    }

    private static Guid? ParseGuidFilter(string? value)
    {
        return Guid.TryParse(value, out var id) ? id : null;
    }

    private bool? ParsePublishedFilter()
    {
        return publishedFilter switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
    }

    private bool? ParseActiveFilter()
    {
        return activeFilter switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
    }

    private static string GetPublishedBadgeClass(bool isPublished) =>
        isPublished ? "status-badge success" : "status-badge warning";

    private static string GetActiveBadgeClass(bool isActive) =>
        isActive ? "status-badge neutral" : "status-badge muted";

    private static string PublicQuizUrl(string slug) => $"/quizzes/{slug}";

    private static QuizSearchResponse EmptySearchResult()
    {
        return new QuizSearchResponse([], 1, 10, 0, 0, false, false);
    }
}
