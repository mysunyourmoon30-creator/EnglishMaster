@page "/admin/content-quality/checks"
@rendermode InteractiveServer
@inject IContentQualityApiClient ContentQualityApiClient

<PageTitle>Quality Checks</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>Quality Checks</h1>
        <p class="page-subtitle">Review automated content quality check runs and their findings.</p>
    </div>
</section>

<section class="panel filter-bar">
    <InputText @bind-Value="contentType" placeholder="Content type" />
    <InputText @bind-Value="status" placeholder="Status" />
    <button class="button" type="button" @onclick="SearchAsync">Search</button>
</section>

@if (isLoading)
{
    <div class="panel loading-indicator"><Icon Name="spinner" Class="spin" Size="16" /><span>Loading checks...</span></div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (checks.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="quality" Size="22" /></span>
        <strong>No quality checks found</strong>
        <p>Try adjusting your filters, or run a check from the dashboard.</p>
    </section>
}
else
{
    <section class="content-list">
        @foreach (var check in checks)
        {
            <article class="panel">
                <div class="item-header">
                    <div>
                        <h2><Icon Name="quality" Size="17" /> @check.ContentType</h2>
                        <p class="muted">@check.ContentId · @check.CheckedAt.LocalDateTime.ToString("g", CultureInfo.InvariantCulture)</p>
                    </div>
                    <span class="badge">@check.Status · @check.Score</span>
                </div>
                <a class="button small" href="@AdminRoutes.ContentQuality.CheckDetail(check.Id)" aria-label="View check for @check.ContentType" title="View"><Icon Name="eye" Size="15" /></a>
            </article>
        }
    </section>
}

@code {
    private IReadOnlyCollection<ContentQualityCheckDto> checks = [];
    private string? contentType;
    private string? status;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await SearchAsync();

    private async Task SearchAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            checks = (await ContentQualityApiClient.SearchChecksAsync(contentType, status, CancellationToken.None)).Items;
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
