@page "/admin/content-quality/rules"
@rendermode InteractiveServer
@inject IContentQualityApiClient ContentQualityApiClient

<PageTitle>Quality Rules</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>Quality Rules</h1>
        <p class="page-subtitle">Configure the rules that drive automated content quality checks.</p>
    </div>
    <div class="actions">
        <a class="button primary" href="@AdminRoutes.ContentQuality.CreateRule"><Icon Name="plus" Size="16" /> Create</a>
    </div>
</section>

@if (isLoading)
{
    <LoadingIndicator Text="Loading rules..." />
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (rules.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="report" Size="22" /></span>
        <strong>No quality rules found</strong>
        <p>Create the first rule to start running automated content quality checks.</p>
        <div class="actions">
            <a class="button primary" href="@AdminRoutes.ContentQuality.CreateRule"><Icon Name="plus" Size="16" /> Create</a>
        </div>
    </section>
}
else
{
    <section class="content-list">
        @foreach (var rule in rules)
        {
            <article class="panel">
                <div class="item-header">
                    <div>
                        <h2><Icon Name="report" Size="17" /> @rule.Code</h2>
                        <p>@rule.Name</p>
                    </div>
                    <span class="badge">@rule.Severity</span>
                </div>
                <a class="button small" href="@AdminRoutes.ContentQuality.EditRule(rule.Id)" aria-label="Edit @rule.Code" title="Edit"><Icon Name="edit" Size="15" /></a>
            </article>
        }
    </section>
}

@code {
    private IReadOnlyCollection<ContentQualityRuleDto> rules = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            rules = (await ContentQualityApiClient.SearchRulesAsync(null, null, null, CancellationToken.None)).Items;
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
