@page "/search"
@layout PublicLayout
@inject IPublicSearchApiClient SearchApiClient
@inject NavigationManager NavigationManager

<PageTitle>Search / ค้นหา</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">DISCOVER / ค้นหาเนื้อหา</p>
        <h1>Search EnglishMaster</h1>
        <p class="page-subtitle">Find words, lessons, quizzes, grammar, courses, and books in one place. / ค้นหาคำศัพท์ บทเรียน แบบฝึก ไวยากรณ์ คอร์ส และหนังสือได้จากที่เดียว</p>
    </div>
    <div class="actions">
        <a class="button secondary" href="/learn">Learn / เริ่มเรียน</a>
        <a class="button primary" href="/search?type=word">Dictionary / คำศัพท์</a>
    </div>
</section>

<section class="panel release-note">
    <div>
        <strong>Start simple / เริ่มง่าย ๆ</strong>
        <p class="muted">Try a word like <strong>ability</strong>, open a lesson, or choose Quizzes to practice. / ลองค้นคำว่า ability เปิดบทเรียน หรือเลือก Quizzes เพื่อฝึกทำแบบฝึก</p>
    </div>
</section>

<form class="panel filters-grid" @onsubmit="SubmitSearchAsync" @onsubmit:preventDefault>
    <label>
        <span>Search / คำค้น</span>
        <input class="input" placeholder="Try: the, ability, practice / ลองค้นหา: the, ability, practice" @bind="query" @bind:event="oninput" />
    </label>
    <label>
        <span>Type / ประเภท</span>
        <select class="input" @bind="contentType">
            <option value="">All / ทั้งหมด</option>
            @foreach (var type in filters.ContentTypes)
            {
                <option value="@type.Key">@ContentTypeLabel(type.Key, type.Label)</option>
            }
        </select>
    </label>
    <label>
        <span>CEFR / ระดับ</span>
        <select class="input" @bind="cefrLevel">
            <option value="">All / ทุกระดับ</option>
            @foreach (var cefr in filters.CefrLevels)
            {
                <option value="@cefr.Key">@cefr.Label</option>
            }
        </select>
    </label>
    <label>
        <span>Category / หมวดหมู่</span>
        <select class="input" @bind="categoryIdText">
            <option value="">All / ทุกหมวด</option>
            @foreach (var category in filters.Categories)
            {
                <option value="@category.Key">@category.Label</option>
            }
        </select>
    </label>
    <label>
        <span>Tag / ป้ายกำกับ</span>
        <select class="input" @bind="tagIdText">
            <option value="">All / ทุกป้าย</option>
            @foreach (var tag in filters.Tags)
            {
                <option value="@tag.Key">@tag.Label</option>
            }
        </select>
    </label>
    <button class="button primary" type="submit"><Icon Name="search" Size="16" /> Search / ค้นหา</button>
</form>

<section class="content-section">
    <div class="section-header-row">
        <div>
            <h2>Quick search / ค้นหาเร็ว</h2>
            <p class="muted">Use these shortcuts to explore the real learning content. / ใช้ปุ่มลัดเพื่อดูเนื้อหาที่ใช้เรียนจริง</p>
        </div>
    </div>
    <div class="list-card-badges">
        <button class="button small" type="button" @onclick="@(() => QuickSearchAsync("the", "word"))">the</button>
        <button class="button small" type="button" @onclick="@(() => QuickSearchAsync("ability", "word"))">ability</button>
        <button class="button small" type="button" @onclick="@(() => QuickSearchAsync(null, "lesson"))">Lessons / บทเรียน</button>
        <button class="button small" type="button" @onclick="@(() => QuickSearchAsync(null, "quiz"))">Quizzes / แบบฝึก</button>
        <button class="button small" type="button" @onclick="@(() => QuickSearchAsync(null, "grammar"))">Grammar / ไวยากรณ์</button>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (isLoading)
{
    <section class="panel empty-state">
        <strong>Loading results... / กำลังโหลดผลลัพธ์</strong>
        <span class="muted">Please wait a moment. / รอสักครู่</span>
    </section>
}
else if (results.Items.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="search" Size="22" /></span>
        <strong>No results found / ไม่พบผลลัพธ์</strong>
        <p>Try a broader word, remove filters, or choose a quick search above. / ลองใช้คำค้นที่กว้างขึ้น ล้างตัวกรอง หรือเลือกปุ่มค้นหาเร็วด้านบน</p>
    </section>
}
else
{
    <section class="content-list">
        <div class="list-summary">
            <span class="muted">Page @results.PageNumber of @Math.Max(results.TotalPages, 1) / หน้า @results.PageNumber จาก @Math.Max(results.TotalPages, 1)</span>
            <span class="pill">@results.TotalCount results / @results.TotalCount ผลลัพธ์</span>
        </div>
        @foreach (var item in results.Items)
        {
            <article class="list-card">
                <div class="list-card-badges">
                    <span class="pill">@ContentTypeLabel(item.ContentType, item.ContentType)</span>
                    @if (!string.IsNullOrWhiteSpace(item.CefrLevel))
                    {
                        <span class="pill">@item.CefrLevel</span>
                    }
                </div>
                <h2><a href="@item.Url">@item.Title</a></h2>
                <p>@FirstNonEmpty(item.HighlightText, item.Summary, "Open to view details. / เปิดเพื่อดูรายละเอียด")</p>
                <div class="meta-row">
                    @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                    {
                        <span>@item.CategoryName</span>
                    }
                    @foreach (var tag in item.Tags.Take(4))
                    {
                        <span>@tag</span>
                    }
                </div>
                <div class="actions">
                    <a class="button small primary" href="@item.Url">Open / เปิดดู</a>
                </div>
            </article>
        }
        <div class="pagination">
            <button class="button small" type="button" disabled="@(!results.HasPreviousPage)" @onclick="PreviousPageAsync">Previous / ก่อนหน้า</button>
            <span class="muted">Page @results.PageNumber / หน้า @results.PageNumber</span>
            <button class="button small" type="button" disabled="@(!results.HasNextPage)" @onclick="NextPageAsync">Next / ถัดไป</button>
        </div>
    </section>
}

@code {
    private PublicSearchFiltersResponse filters = new([], [], [], []);
    private PublicSearchResponse results = EmptyResults();
    private string? query;
    private string? contentType;
    private string? cefrLevel;
    private string? categoryIdText;
    private string? tagIdText;
    private int pageNumber = 1;
    private bool isLoading;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var queryParameters = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        query = queryParameters.TryGetValue("q", out var q) ? q.ToString() : null;
        contentType = queryParameters.TryGetValue("type", out var type) ? type.ToString() : null;
        cefrLevel = queryParameters.TryGetValue("cefr", out var cefr) ? cefr.ToString() : null;
        await LoadFiltersAsync();
        await SearchAsync();
    }

    private async Task LoadFiltersAsync()
    {
        try
        {
            filters = await SearchApiClient.GetFiltersAsync(CancellationToken.None);
        }
        catch (ApiRequestException)
        {
            filters = new([], [], [], []);
        }
    }

    private async Task SearchAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            results = await SearchApiClient.SearchAsync(query, contentType, cefrLevel, ParseId(categoryIdText), ParseId(tagIdText), pageNumber, 10, CancellationToken.None);
        }
        catch (ApiRequestException)
        {
            results = EmptyResults();
            errorMessage = "Search is unavailable right now. / ตอนนี้ยังค้นหาไม่ได้";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitSearchAsync()
    {
        pageNumber = 1;
        await SearchAsync();
    }

    private async Task QuickSearchAsync(string? nextQuery, string nextType)
    {
        query = nextQuery;
        contentType = nextType;
        cefrLevel = null;
        categoryIdText = null;
        tagIdText = null;
        pageNumber = 1;
        await SearchAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (!results.HasPreviousPage)
        {
            return;
        }

        pageNumber--;
        await SearchAsync();
    }

    private async Task NextPageAsync()
    {
        if (!results.HasNextPage)
        {
            return;
        }

        pageNumber++;
        await SearchAsync();
    }

    private static Guid? ParseId(string? value) =>
        Guid.TryParse(value, out var id) ? id : null;

    private static string ContentTypeLabel(string key, string fallback) => key.ToLowerInvariant() switch
    {
        "word" => "Word / คำศัพท์",
        "grammar" => "Grammar / ไวยากรณ์",
        "lesson" => "Lesson / บทเรียน",
        "course" => "Course / คอร์ส",
        "book" => "Book / หนังสือ",
        "quiz" => "Quiz / แบบฝึก",
        _ => fallback
    };

    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private static PublicSearchResponse EmptyResults() =>
        new([], 1, 10, 0, 0, false, false);
}
