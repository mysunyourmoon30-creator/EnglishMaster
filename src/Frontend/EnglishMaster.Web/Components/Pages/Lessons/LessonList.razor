@page "/admin/lessons"
@rendermode InteractiveServer
@inject ILessonApiClient LessonApiClient
@inject ICategoriesApiClient CategoriesApiClient

<PageTitle>Lessons</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">LESSONS / บทเรียน</p>
        <h1>Common Word Lessons</h1>
        <p class="page-subtitle">50 lessons built from the 2,500 most useful English words, sorted from most common to less common. / บทเรียน 50 ชุดจากคำอังกฤษที่ใช้จริงบ่อยที่สุด 2,500 คำ เรียงจากพบบ่อยมากไปน้อย ชุดละ 50 คำ</p>
    </div>
    <div class="actions">
        <a class="button" href="/learn/study-plan">Learner plan / แผนเรียน</a>
        <a class="button primary" href="@AdminRoutes.Lessons.Create"><Icon Name="plus" Size="16" /> New Lesson / เพิ่มบทเรียน</a>
    </div>
</section>

<section class="panel release-note">
    <div>
        <strong>Content structure / โครงสร้างเนื้อหา</strong>
        <p class="muted">Each lesson should contain a clear summary, learner-friendly sections, related words, and optional grammar rules.</p>
        <p class="muted">แต่ละบทควรมีสรุปสั้น เนื้อหาที่อ่านง่าย คำศัพท์ที่เกี่ยวข้อง และไวยากรณ์เสริมถ้ามี</p>
    </div>
</section>

<section class="panel">
    <form class="filters-grid" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label>
            <span>Search / ค้นหา</span>
            <input class="input" placeholder="Common Words, lesson title, or summary / ชื่อบทเรียนหรือสรุป" @bind="search" @bind:event="oninput" />
        </label>
        <label>
            <span>CEFR</span>
            <select class="input" @bind="cefrLevel">
                <option value="">All / ทุกระดับ</option>
                @foreach (var level in CefrLevels)
                {
                    <option value="@level">@level</option>
                }
            </select>
        </label>
        <label>
            <span>Category / หมวดหมู่</span>
            <select class="input" @bind="categoryId">
                <option value="">All / ทั้งหมด</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </label>
        <label>
            <span>Published / เผยแพร่</span>
            <select class="input" @bind="publishedFilter">
                <option value="">All / ทั้งหมด</option>
                <option value="true">Published / เผยแพร่แล้ว</option>
                <option value="false">Draft / ร่าง</option>
            </select>
        </label>
        <label>
            <span>Status / สถานะ</span>
            <select class="input" @bind="activeFilter">
                <option value="true">Active / ใช้งาน</option>
                <option value="false">Inactive / ปิดใช้</option>
                <option value="">All / ทั้งหมด</option>
            </select>
        </label>
        <label>
            <span>Page Size / จำนวนต่อหน้า</span>
            <select class="input" @bind="pageSize">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </label>
        <button class="button" type="submit">Search / ค้นหา</button>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}

@if (isLoading)
{
    <LoadingIndicator Text="Loading lessons... / กำลังโหลดบทเรียน" />
}
else if (lessons.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="lesson" Size="22" /></span>
        <strong>No lessons found / ยังไม่พบบทเรียน</strong>
        <p>Try changing filters or create a new lesson. / ลองเปลี่ยนตัวกรอง หรือเพิ่มบทเรียนใหม่</p>
        <div class="actions">
            <a class="button primary" href="@AdminRoutes.Lessons.Create"><Icon Name="plus" Size="16" /> New Lesson / เพิ่มบทเรียน</a>
        </div>
    </section>
}
else
{
    <section class="table-wrap">
        <div class="pagination-summary">
            <span class="muted">Page @searchResult.PageNumber of @searchResult.TotalPages / หน้า @searchResult.PageNumber จาก @searchResult.TotalPages</span>
            <span class="status-badge neutral">@searchResult.TotalCount lessons / @searchResult.TotalCount บทเรียน</span>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Lesson / บทเรียน</th>
                    <th>Word rank / ลำดับคำ</th>
                    <th>CEFR</th>
                    <th>Category / หมวดหมู่</th>
                    <th>Learner page / หน้าผู้เรียน</th>
                    <th>Published / เผยแพร่</th>
                    <th>Status / สถานะ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lesson in lessons)
                {
                    <tr>
                        <td>
                            <strong>@lesson.Title</strong>
                            <span class="muted">@lesson.Summary</span>
                            <span class="category-slug">@lesson.Slug</span>
                        </td>
                        <td><span class="category-page">@GetRankRange(lesson)</span></td>
                        <td>@(lesson.CefrLevel ?? "-")</td>
                        <td>@(lesson.Category?.Name ?? "-")</td>
                        <td>
                            @if (lesson.IsPublished && !string.IsNullOrWhiteSpace(lesson.Slug))
                            {
                                <a class="button small" href="@PublicLessonUrl(lesson.Slug)">Open / เปิดดู</a>
                            }
                            else
                            {
                                <span class="muted">Publish first / เผยแพร่ก่อน</span>
                            }
                        </td>
                        <td>
                            <span class="status-badge @(lesson.IsPublished ? "success" : "warning")">
                                @(lesson.IsPublished ? "Published / เผยแพร่แล้ว" : "Draft / ร่าง")
                            </span>
                        </td>
                        <td>
                            <span class="status-badge @(lesson.IsActive ? "success" : "muted")">
                                @(lesson.IsActive ? "Active / ใช้งาน" : "Inactive / ปิดใช้")
                            </span>
                        </td>
                        <td class="row-actions">
                            <a class="button small" href="@AdminRoutes.Lessons.Detail(lesson.Id)" aria-label="View @lesson.Title" title="View"><Icon Name="eye" Size="15" /></a>
                            <a class="button small" href="@AdminRoutes.Lessons.Edit(lesson.Id)" aria-label="Edit @lesson.Title" title="Edit"><Icon Name="edit" Size="15" /></a>
                            <button class="button small danger" type="button" @onclick="() => DeleteAsync(lesson.Id)" aria-label="Delete @lesson.Title" title="Delete"><Icon Name="trash" Size="15" /></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="pagination-row">
            <button class="button small" type="button" disabled="@(!searchResult.HasPreviousPage)" @onclick="PreviousPageAsync">Previous / ก่อนหน้า</button>
            <span class="muted">Page @searchResult.PageNumber / หน้า @searchResult.PageNumber</span>
            <button class="button small" type="button" disabled="@(!searchResult.HasNextPage)" @onclick="NextPageAsync">Next / ถัดไป</button>
        </div>
    </section>
}

@code {
    private static readonly string[] CefrLevels = ["A1", "A2", "B1", "B2", "C1", "C2"];

    private IReadOnlyCollection<LessonDto> lessons = [];
    private IReadOnlyCollection<CategoryDto> categories = [];
    private LessonSearchResponse searchResult = EmptySearchResult();
    private string? search = "Common Words";
    private string? cefrLevel;
    private string? categoryId;
    private string publishedFilter = "true";
    private string activeFilter = "true";
    private int pageNumber = 1;
    private int pageSize = 50;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = (await CategoriesApiClient.SearchAsync(search: null, isActive: true, CancellationToken.None)).Items;
        }
        catch (ApiRequestException)
        {
            categories = [];
        }

        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            searchResult = await LessonApiClient.SearchAsync(
                new LessonSearchRequest(
                    search,
                    string.IsNullOrWhiteSpace(cefrLevel) ? null : cefrLevel,
                    ParseCategoryFilter(),
                    ParsePublishedFilter(),
                    ParseActiveFilter(),
                    pageNumber,
                    pageSize,
                    SortBy: "CreatedAt",
                    SortDirection: "Asc"),
                CancellationToken.None);
            lessons = searchResult.Items;
        }
        catch (ApiRequestException exception)
        {
            searchResult = EmptySearchResult();
            lessons = [];
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (!searchResult.HasPreviousPage)
        {
            return;
        }

        pageNumber--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (!searchResult.HasNextPage)
        {
            return;
        }

        pageNumber++;
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        errorMessage = null;

        try
        {
            await LessonApiClient.DeleteAsync(id, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
    }

    private Guid? ParseCategoryFilter()
    {
        return Guid.TryParse(categoryId, out var id) ? id : null;
    }

    private bool? ParsePublishedFilter()
    {
        return publishedFilter switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
    }

    private bool? ParseActiveFilter()
    {
        return activeFilter switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
    }

    private static LessonSearchResponse EmptySearchResult()
    {
        return new LessonSearchResponse([], 1, 50, 0, 0, false, false);
    }

    private static string PublicLessonUrl(string slug) => $"/lessons/{slug}";

    private static string GetRankRange(LessonDto lesson)
    {
        var parts = lesson.Slug.Split('-', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 4 &&
            int.TryParse(parts[^2], out var startRank) &&
            int.TryParse(parts[^1], out var endRank))
        {
            return $"{startRank:N0}-{endRank:N0}";
        }

        return "-";
    }
}
