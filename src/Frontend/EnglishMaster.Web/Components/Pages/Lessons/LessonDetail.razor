@page "/admin/lessons/{Id:guid}"
@rendermode InteractiveServer
@inject ILessonApiClient LessonApiClient
@inject IWordsApiClient WordsApiClient
@inject IGrammarApiClient GrammarApiClient
@inject IMediaApiClient MediaApiClient

<PageTitle>@(lesson is null ? "Lesson" : lesson.Title)</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">LESSON BUILDER / ตัวสร้างบทเรียน</p>
        <h1>@(lesson is null ? "Lesson" : lesson.Title)</h1>
        @if (lesson is not null)
        {
            <p class="page-subtitle">Review lesson content, related words, grammar links, and learner visibility. / ตรวจเนื้อหา คำศัพท์ ไวยากรณ์ และสถานะที่ผู้เรียนเห็น</p>
        }
    </div>
    <div class="actions">
        <a class="button" href="@AdminRoutes.Lessons.Index">Back / กลับ</a>
        @if (lesson is not null)
        {
            @if (lesson.IsPublished && !string.IsNullOrWhiteSpace(lesson.Slug))
            {
                <a class="button" href="@PublicLessonUrl(lesson.Slug)">Learner page / หน้าผู้เรียน</a>
            }
            <a class="button" href="@AdminRoutes.ContentRevisions.Timeline("Lesson", lesson.Id)"><Icon Name="revision" Size="15" /> History / ประวัติ</a>
            <a class="button primary" href="@AdminRoutes.Lessons.Edit(lesson.Id)"><Icon Name="edit" Size="15" /> Edit / แก้ไข</a>
            <button class="button" type="button" @onclick="TogglePublishAsync">
                <Icon Name="publish" Size="15" /> @(lesson.IsPublished ? "Unpublish / ปิดเผยแพร่" : "Publish / เผยแพร่")
            </button>
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}

@if (isLoading)
{
    <p class="muted">Loading lesson... / กำลังโหลดบทเรียน</p>
}
else if (notFound)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="lesson" Size="22" /></span>
        <strong>Lesson was not found / ไม่พบบทเรียน</strong>
        <p>It may have been deleted or the link is incorrect. / อาจถูกลบแล้ว หรือลิงก์ไม่ถูกต้อง</p>
        <div class="actions">
            <a class="button" href="@AdminRoutes.Lessons.Index">Back to Lessons / กลับรายการบทเรียน</a>
        </div>
    </section>
}
else if (lesson is not null)
{
    <section class="panel release-note">
        <div>
            <strong>@(lesson.IsPublished ? "Published to learners / เปิดให้ผู้เรียนแล้ว" : "Draft mode / ยังเป็นฉบับร่าง")</strong>
            @if (lesson.IsPublished && !string.IsNullOrWhiteSpace(lesson.Slug))
            {
                <p class="muted">Learners can open this lesson at <a href="@PublicLessonUrl(lesson.Slug)">@PublicLessonUrl(lesson.Slug)</a>.</p>
            }
            else
            {
                <p class="muted">Check sections and related words, then publish when the lesson is ready. / ตรวจ section และคำศัพท์ให้ครบ แล้วค่อยเผยแพร่</p>
            }
        </div>
    </section>

    <section class="panel">
        @if (lesson.ThumbnailMedia is not null)
        {
            <img class="thumbnail" src="@lesson.ThumbnailMedia.PublicUrl" alt="@lesson.ThumbnailMedia.AltText" />
        }

        <h3 class="detail-section-heading">Identity / ข้อมูลหลัก</h3>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="muted">Slug</span>
                <strong>@lesson.Slug</strong>
            </div>
            <div class="detail-item">
                <span class="muted">CEFR</span>
                <strong>@(lesson.CefrLevel ?? "-")</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Category / หมวดหมู่</span>
                <strong>@(lesson.Category?.Name ?? "-")</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Status / สถานะ</span>
                <strong>@(lesson.IsActive ? "Active / ใช้งาน" : "Inactive / ปิด")</strong>
            </div>
        </div>

        <h3 class="detail-section-heading">Scheduling / เวลาและลำดับ</h3>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="muted">Estimated Minutes / เวลาประมาณ</span>
                <strong>@lesson.EstimatedMinutes</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Sort Order / ลำดับ</span>
                <strong>@lesson.SortOrder</strong>
            </div>
            <div class="detail-item">
                <span class="muted">Published / เผยแพร่</span>
                <strong>@(lesson.IsPublished ? "Published / เผยแพร่แล้ว" : "Draft / ร่าง")</strong>
            </div>
        </div>

        <h3 class="detail-section-heading">Description / คำอธิบาย</h3>
        <div class="detail-grid">
            <div class="detail-item full">
                <span class="muted">Summary / สรุปสั้น</span>
                <strong>@lesson.Summary</strong>
            </div>
            <div class="detail-item full">
                <span class="muted">Description / รายละเอียด</span>
                <strong>@lesson.Description</strong>
            </div>
        </div>
    </section>

    <section class="page-header section-header">
        <div>
            <p class="eyebrow">CONTENT / เนื้อหา</p>
            <h1>Sections / ส่วนของบทเรียน</h1>
        </div>
    </section>

    @if (sections.Count == 0)
    {
        <section class="panel nested-table empty-state left-aligned">
            <span class="empty-state-icon"><Icon Name="lesson" Size="22" /></span>
            <strong>No sections yet / ยังไม่มีเนื้อหา</strong>
            <p>Add the first section using the form below. / เพิ่ม section แรกจากฟอร์มด้านล่าง</p>
        </section>
    }
    else
    {
        var orderedSections = sections.OrderBy(item => item.SortOrder).ToList();

        <div class="repeater-list">
            @for (var index = 0; index < orderedSections.Count; index++)
            {
                var lessonSection = orderedSections[index];
                var displayIndex = index + 1;

                <div class="repeater-item">
                    <div class="repeater-item-header">
                        <span class="repeater-item-index">@displayIndex</span>
                        <span class="repeater-item-title">@lessonSection.Title</span>
                        <div class="row-actions">
                            <button class="button small" type="button" @onclick="() => MoveSectionUpAsync(lessonSection.Id)" aria-label="Move section @displayIndex up" title="Move up"><Icon Name="chevron-up" Size="15" /></button>
                            <button class="button small" type="button" @onclick="() => MoveSectionDownAsync(lessonSection.Id)" aria-label="Move section @displayIndex down" title="Move down"><Icon Name="chevron-down" Size="15" /></button>
                            <button class="button small" type="button" @onclick="() => EditSection(lessonSection)" aria-label="Edit section @displayIndex" title="Edit"><Icon Name="edit" Size="15" /></button>
                            <button class="button small danger" type="button" @onclick="() => DeleteSectionAsync(lessonSection.Id)" aria-label="Delete section @displayIndex" title="Delete"><Icon Name="trash" Size="15" /></button>
                        </div>
                    </div>
                    <div class="detail-grid">
                        <div class="detail-item">
                            <span class="muted">Type / ประเภท</span>
                            <strong>@lessonSection.SectionType</strong>
                        </div>
                        <div class="detail-item">
                            <span class="muted">Sort Order / ลำดับ</span>
                            <strong>@lessonSection.SortOrder</strong>
                        </div>
                        <div class="detail-item">
                            <span class="muted">Status / สถานะ</span>
                            <strong>@(lessonSection.IsActive ? "Active / ใช้งาน" : "Inactive / ปิด")</strong>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <section class="panel pair-form-panel">
        <h2>@(editingSectionId.HasValue ? "Edit Section / แก้ไขส่วนบทเรียน" : "Add Section / เพิ่มส่วนบทเรียน")</h2>
        @if (!string.IsNullOrWhiteSpace(sectionErrorMessage))
        {
            <div class="alert error">@sectionErrorMessage</div>
        }
        <LessonSectionForm Model="sectionModel"
                           MediaOptions="mediaOptions"
                           ValidationErrors="sectionValidationErrors"
                           IsSaving="isSectionSaving"
                           ShowActiveToggle="@editingSectionId.HasValue"
                           SubmitText="@(editingSectionId.HasValue ? "Save Section / บันทึก" : "Add Section / เพิ่ม")"
                           OnValidSubmit="SaveSectionAsync"
                           OnCancel="CancelSectionEditAsync" />
    </section>

    <section class="page-header section-header">
        <div>
            <p class="eyebrow">VOCABULARY / คำศัพท์</p>
            <h1>Related Words / คำศัพท์ในบทนี้</h1>
        </div>
    </section>

    <section class="panel">
        @if (!string.IsNullOrWhiteSpace(relatedWordErrorMessage))
        {
            <div class="alert error">@relatedWordErrorMessage</div>
        }

        <div class="filters-grid">
            <label>
                <span>Word / คำศัพท์</span>
                <InputSelect class="input" @bind-Value="selectedWordId">
                    <option value="">Select word / เลือกคำศัพท์</option>
                    @foreach (var word in AvailableWords())
                    {
                        <option value="@word.Id">@word.Text</option>
                    }
                </InputSelect>
            </label>
            <button class="button" type="button" @onclick="AddRelatedWordAsync">Add Word / เพิ่มคำศัพท์</button>
        </div>
    </section>

    @if (lesson.Words.Count == 0)
    {
        <section class="panel nested-table empty-state left-aligned">
            <span class="empty-state-icon"><Icon Name="word" Size="22" /></span>
            <strong>No related words yet / ยังไม่มีคำศัพท์ที่ผูกกับบทนี้</strong>
            <p>Add a word above to link it with this lesson. / เลือกคำศัพท์ด้านบนเพื่อผูกกับบทเรียน</p>
        </section>
    }
    else
    {
        <section class="table-wrap nested-table">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Word / คำศัพท์</th>
                        <th>Meaning TH / ความหมายไทย</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var word in lesson.Words)
                    {
                        <tr>
                            <td>
                                <strong>@word.Text</strong>
                                <span class="muted">@word.Slug</span>
                            </td>
                            <td>@word.MeaningTh</td>
                            <td class="row-actions">
                                <a class="button small" href="@AdminRoutes.Words.Detail(word.Id)" aria-label="View @word.Text" title="View"><Icon Name="eye" Size="15" /></a>
                                <button class="button small danger" type="button" @onclick="() => RemoveRelatedWordAsync(word.Id)" aria-label="Remove @word.Text" title="Remove"><Icon Name="trash" Size="15" /></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    <section class="page-header section-header">
        <div>
            <p class="eyebrow">GRAMMAR / ไวยากรณ์</p>
            <h1>Related Grammar Rules / ไวยากรณ์ที่เกี่ยวข้อง</h1>
        </div>
    </section>

    <section class="panel">
        @if (!string.IsNullOrWhiteSpace(relatedGrammarRuleErrorMessage))
        {
            <div class="alert error">@relatedGrammarRuleErrorMessage</div>
        }

        <div class="filters-grid">
            <label>
                <span>Grammar Rule / กฎไวยากรณ์</span>
                <InputSelect class="input" @bind-Value="selectedGrammarRuleId">
                    <option value="">Select rule / เลือกกฎ</option>
                    @foreach (var rule in AvailableGrammarRules())
                    {
                        <option value="@rule.Id">@rule.Title</option>
                    }
                </InputSelect>
            </label>
            <button class="button" type="button" @onclick="AddRelatedGrammarRuleAsync">Add Rule / เพิ่มกฎ</button>
        </div>
    </section>

    @if (lesson.GrammarRules.Count == 0)
    {
        <section class="panel nested-table empty-state left-aligned">
            <span class="empty-state-icon"><Icon Name="grammar" Size="22" /></span>
            <strong>No related grammar rules yet / ยังไม่มีไวยากรณ์ที่เกี่ยวข้อง</strong>
            <p>Add a rule above to link it with this lesson. / เลือกกฎด้านบนเพื่อผูกกับบทเรียน</p>
        </section>
    }
    else
    {
        <section class="table-wrap nested-table">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Title / ชื่อกฎ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rule in lesson.GrammarRules)
                    {
                        <tr>
                            <td>
                                <strong>@rule.Title</strong>
                                <span class="muted">@rule.Slug</span>
                            </td>
                            <td class="row-actions">
                                <a class="button small" href="@AdminRoutes.GrammarRules.Detail(rule.Id)" aria-label="View @rule.Title" title="View"><Icon Name="eye" Size="15" /></a>
                                <button class="button small danger" type="button" @onclick="() => RemoveRelatedGrammarRuleAsync(rule.Id)" aria-label="Remove @rule.Title" title="Remove"><Icon Name="trash" Size="15" /></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private LessonDto? lesson;
    private IReadOnlyCollection<LessonSectionDto> sections = [];
    private IReadOnlyCollection<WordDto> words = [];
    private IReadOnlyCollection<GrammarRuleDto> grammarRules = [];
    private IReadOnlyCollection<MediaDto> mediaOptions = [];
    private LessonSectionFormModel sectionModel = new();
    private Guid? editingSectionId;
    private Guid? selectedWordId;
    private Guid? selectedGrammarRuleId;
    private IReadOnlyDictionary<string, string[]> sectionValidationErrors = new Dictionary<string, string[]>();
    private string? errorMessage;
    private string? sectionErrorMessage;
    private string? relatedWordErrorMessage;
    private string? relatedGrammarRuleErrorMessage;
    private bool isLoading = true;
    private bool isSectionSaving;
    private bool notFound;

    private static string PublicLessonUrl(string slug) => $"/lessons/{slug}";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        notFound = false;
        errorMessage = null;

        try
        {
            words = (await WordsApiClient.SearchAsync(
                new WordSearchRequest(IsActive: true, PageSize: 100, SortBy: "Text", SortDirection: "Asc"),
                CancellationToken.None)).Items;
            grammarRules = (await GrammarApiClient.SearchRulesAsync(
                new GrammarRuleSearchRequest(IsActive: true, PageSize: 100),
                CancellationToken.None)).Items;
            mediaOptions = (await MediaApiClientSearchAsync()).Items;

            lesson = await LessonApiClient.GetAsync(Id, CancellationToken.None);
            if (lesson is null)
            {
                notFound = true;
                return;
            }

            sections = await LessonApiClient.GetSectionsAsync(Id, CancellationToken.None);
            if (!editingSectionId.HasValue)
            {
                ResetSectionForm();
            }
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task<MediaSearchResponse> MediaApiClientSearchAsync()
    {
        return MediaApiClient.SearchAsync(new MediaSearchRequest(IsActive: true, PageSize: 100), CancellationToken.None);
    }

    private IEnumerable<WordDto> AvailableWords()
    {
        var relatedWordIds = lesson?.Words.Select(word => word.Id).ToHashSet() ?? [];
        return words.Where(word => !relatedWordIds.Contains(word.Id));
    }

    private IEnumerable<GrammarRuleDto> AvailableGrammarRules()
    {
        var relatedRuleIds = lesson?.GrammarRules.Select(rule => rule.Id).ToHashSet() ?? [];
        return grammarRules.Where(rule => !relatedRuleIds.Contains(rule.Id));
    }

    private async Task TogglePublishAsync()
    {
        if (lesson is null)
        {
            return;
        }

        errorMessage = null;

        try
        {
            if (lesson.IsPublished)
            {
                await LessonApiClient.UnpublishAsync(lesson.Id, CancellationToken.None);
            }
            else
            {
                await LessonApiClient.PublishAsync(lesson.Id, CancellationToken.None);
            }

            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            errorMessage = exception.Message;
        }
    }

    private async Task AddRelatedWordAsync()
    {
        if (lesson is null || !selectedWordId.HasValue)
        {
            return;
        }

        relatedWordErrorMessage = null;

        try
        {
            await LessonApiClient.AddWordAsync(lesson.Id, selectedWordId.Value, lesson.Words.Count, CancellationToken.None);
            selectedWordId = null;
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            relatedWordErrorMessage = exception.Message;
        }
    }

    private async Task RemoveRelatedWordAsync(Guid wordId)
    {
        if (lesson is null)
        {
            return;
        }

        relatedWordErrorMessage = null;

        try
        {
            await LessonApiClient.RemoveWordAsync(lesson.Id, wordId, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            relatedWordErrorMessage = exception.Message;
        }
    }

    private async Task AddRelatedGrammarRuleAsync()
    {
        if (lesson is null || !selectedGrammarRuleId.HasValue)
        {
            return;
        }

        relatedGrammarRuleErrorMessage = null;

        try
        {
            await LessonApiClient.AddGrammarRuleAsync(
                lesson.Id,
                selectedGrammarRuleId.Value,
                lesson.GrammarRules.Count,
                CancellationToken.None);
            selectedGrammarRuleId = null;
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            relatedGrammarRuleErrorMessage = exception.Message;
        }
    }

    private async Task RemoveRelatedGrammarRuleAsync(Guid grammarRuleId)
    {
        if (lesson is null)
        {
            return;
        }

        relatedGrammarRuleErrorMessage = null;

        try
        {
            await LessonApiClient.RemoveGrammarRuleAsync(lesson.Id, grammarRuleId, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            relatedGrammarRuleErrorMessage = exception.Message;
        }
    }

    private async Task SaveSectionAsync()
    {
        if (lesson is null)
        {
            return;
        }

        isSectionSaving = true;
        sectionErrorMessage = null;
        sectionValidationErrors = new Dictionary<string, string[]>();

        try
        {
            if (editingSectionId.HasValue)
            {
                await LessonApiClient.UpdateSectionAsync(
                    editingSectionId.Value,
                    sectionModel.ToUpdateRequest(),
                    CancellationToken.None);
            }
            else
            {
                await LessonApiClient.AddSectionAsync(lesson.Id, sectionModel.ToCreateRequest(), CancellationToken.None);
            }

            editingSectionId = null;
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            sectionValidationErrors = exception.ValidationErrors;
            sectionErrorMessage = sectionValidationErrors.Count == 0 ? exception.Message : null;
        }
        finally
        {
            isSectionSaving = false;
        }
    }

    private void EditSection(LessonSectionDto section)
    {
        editingSectionId = section.Id;
        sectionModel = LessonSectionFormModel.FromDto(section);
        sectionErrorMessage = null;
        sectionValidationErrors = new Dictionary<string, string[]>();
    }

    private async Task DeleteSectionAsync(Guid id)
    {
        sectionErrorMessage = null;

        try
        {
            await LessonApiClient.DeleteSectionAsync(id, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            sectionErrorMessage = exception.Message;
        }
    }

    private Task CancelSectionEditAsync()
    {
        editingSectionId = null;
        ResetSectionForm();
        return Task.CompletedTask;
    }

    private void ResetSectionForm()
    {
        sectionModel = new LessonSectionFormModel
        {
            SortOrder = sections.Count
        };
        sectionErrorMessage = null;
        sectionValidationErrors = new Dictionary<string, string[]>();
    }

    private async Task MoveSectionUpAsync(Guid id)
    {
        await MoveSectionAsync(id, -1);
    }

    private async Task MoveSectionDownAsync(Guid id)
    {
        await MoveSectionAsync(id, 1);
    }

    private async Task MoveSectionAsync(Guid id, int offset)
    {
        if (lesson is null)
        {
            return;
        }

        var ordered = sections.OrderBy(item => item.SortOrder).Select(item => item.Id).ToList();
        var index = ordered.IndexOf(id);
        var newIndex = index + offset;
        if (index < 0 || newIndex < 0 || newIndex >= ordered.Count)
        {
            return;
        }

        (ordered[index], ordered[newIndex]) = (ordered[newIndex], ordered[index]);
        sectionErrorMessage = null;

        try
        {
            await LessonApiClient.ReorderSectionsAsync(lesson.Id, ordered, CancellationToken.None);
            await LoadAsync();
        }
        catch (ApiRequestException exception)
        {
            sectionErrorMessage = exception.Message;
        }
    }
}
