@page "/learn/achievements"
@inject IMotivationApiClient MotivationApiClient

<PageTitle>Achievements</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Motivation</p>
        <h1>Achievements</h1>
        <p class="page-subtitle">Review earned and in-progress achievements.</p>
    </div>
    <div class="actions">
        <a class="button secondary" href="/learn/motivation"><Icon Name="chevron-left" Size="15" /> Back</a>
        <button class="button primary" type="button" @onclick="EvaluateAsync"><Icon Name="quality" Size="15" /> Evaluate</button>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (isLoading)
{
    <section class="panel empty-state">
        <strong>Loading achievements...</strong>
    </section>
}
else if (achievements.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="certificate" Size="20" /></span>
        <strong>No achievement progress yet</strong>
        <p>Complete lessons, quizzes, and practice to start earning achievements.</p>
        <div class="actions">
            <button class="button primary" type="button" @onclick="EvaluateAsync"><Icon Name="quality" Size="15" /> Evaluate</button>
        </div>
    </section>
}
else
{
    <div class="card-grid">
        @foreach (var achievement in achievements)
        {
            <article class="list-card">
                <span class="pill">@achievement.Status</span>
                <h3>@achievement.Name</h3>
                <p>@achievement.Description</p>
                <p class="muted">@achievement.ProgressValue / @achievement.TargetValue</p>
            </article>
        }
    </div>
}

@code {
    private IReadOnlyCollection<StudentAchievementDto> achievements = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            achievements = await MotivationApiClient.GetAchievementsAsync(CancellationToken.None);
        }
        catch (ApiRequestException)
        {
            errorMessage = "Achievements are unavailable right now.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task EvaluateAsync()
    {
        achievements = await MotivationApiClient.EvaluateAchievementsAsync(CancellationToken.None);
    }
}
