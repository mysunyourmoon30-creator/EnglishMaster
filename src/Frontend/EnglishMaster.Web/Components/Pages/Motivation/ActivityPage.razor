@page "/learn/activity"
@inject IMotivationApiClient MotivationApiClient

<PageTitle>Learning Activity</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Motivation</p>
        <h1>Learning Activity</h1>
        <p class="page-subtitle">Recent study activity across lessons, quizzes, practice, and goals.</p>
    </div>
    <a class="button secondary" href="/learn/motivation"><Icon Name="chevron-left" Size="15" /> Motivation</a>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (isLoading)
{
    <section class="panel empty-state">
        <strong><Icon Name="spinner" Class="spin" Size="16" /> Loading activity...</strong>
    </section>
}
else if (activities.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-state-icon"><Icon Name="analytics" Size="20" /></span>
        <strong>No learning activity recorded yet</strong>
        <p>Complete a lesson, quiz, or practice session and it will show up here.</p>
        <div class="actions">
            <a class="button primary" href="/learn/practice">Start practice</a>
        </div>
    </section>
}
else
{
    <div class="card-grid">
        @foreach (var activity in activities)
        {
            <article class="list-card">
                <span class="pill">@activity.ActivityType</span>
                <h3>@activity.Title</h3>
                <p class="muted">@activity.MinutesSpent minutes - @activity.OccurredAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</p>
            </article>
        }
    </div>
}

@code {
    private IReadOnlyCollection<LearningActivityDto> activities = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            activities = await MotivationApiClient.GetActivityAsync(CancellationToken.None);
        }
        catch (ApiRequestException)
        {
            errorMessage = "Learning activity is unavailable right now.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
