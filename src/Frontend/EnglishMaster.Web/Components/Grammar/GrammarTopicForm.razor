@using EnglishMaster.Web.Services.Grammar

<EditForm Model="Model" OnValidSubmit="SubmitAsync" class="word-form">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (ValidationErrors.Count > 0)
    {
        <div class="alert error">
            <ul>
                @foreach (var error in ValidationErrors.SelectMany(item => item.Value))
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <h3 class="detail-section-heading">Identity / ข้อมูลหลัก</h3>
    <div class="form-grid">
        <label class="span-2">
            <span>Title / ชื่อหัวข้อ<span class="required-marker" aria-hidden="true">*</span></span>
            <InputText class="input" @bind-Value="Model.Title" maxlength="200" aria-required="true" />
            <span class="muted hint">Max 200 characters / สูงสุด 200 ตัวอักษร</span>
            <ValidationMessage For="@(() => Model.Title)" />
        </label>

        <label>
            <span>CEFR<span class="required-marker" aria-hidden="true">*</span></span>
            <InputSelect class="input" @bind-Value="Model.CefrLevel" aria-required="true">
                @foreach (var level in CefrLevels)
                {
                    <option value="@level">@level</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Model.CefrLevel)" />
        </label>

        <label>
            <span>Sort Order / ลำดับแสดงผล</span>
            <InputNumber class="input" @bind-Value="Model.SortOrder" />
            <ValidationMessage For="@(() => Model.SortOrder)" />
        </label>

        @if (ShowActiveToggle)
        {
            <label class="checkbox-row">
                <InputCheckbox @bind-Value="Model.IsActive" />
                <span>Active / ใช้งาน</span>
            </label>
        }
    </div>

    <h3 class="detail-section-heading">Description / คำอธิบาย</h3>
    <div class="form-grid">
        <label class="span-2">
            <span>Summary / สรุปหัวข้อ</span>
            <InputTextArea class="input textarea" @bind-Value="Model.Summary" maxlength="1000" />
            <span class="muted hint">Max 1000 characters / สูงสุด 1000 ตัวอักษร</span>
            <ValidationMessage For="@(() => Model.Summary)" />
        </label>
    </div>

    <div class="actions">
        <button class="button primary" type="submit" disabled="@IsSaving">@SubmitText</button>
        <a class="button" href="@AdminRoutes.GrammarTopics.Index">Cancel / ยกเลิก</a>
    </div>
</EditForm>

@code {
    private static readonly string[] CefrLevels = ["A1", "A2", "B1", "B2", "C1", "C2"];

    [Parameter, EditorRequired]
    public GrammarTopicFormModel Model { get; set; } = new();

    [Parameter]
    public IReadOnlyDictionary<string, string[]> ValidationErrors { get; set; } =
        new Dictionary<string, string[]>();

    [Parameter]
    public bool IsSaving { get; set; }

    [Parameter]
    public bool ShowActiveToggle { get; set; }

    [Parameter]
    public string SubmitText { get; set; } = "Save";

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    private async Task SubmitAsync()
    {
        await OnValidSubmit.InvokeAsync();
    }
}
