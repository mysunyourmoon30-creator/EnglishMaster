<EditForm Model="Model" OnValidSubmit="SubmitAsync" class="word-form">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (ValidationErrors.Count > 0)
    {
        <div class="alert error">
            <ul>
                @foreach (var error in ValidationErrors.SelectMany(item => item.Value))
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <h3 class="detail-section-heading">Identity / ข้อมูลหลัก</h3>
    <div class="form-grid">
        <label>
            <span>Name / ชื่อหมวด</span>
            <InputText class="input" @bind-Value="Model.Name" />
            <ValidationMessage For="@(() => Model.Name)" />
        </label>

        @if (ShowActiveToggle)
        {
            <label class="checkbox-row">
                <InputCheckbox @bind-Value="Model.IsActive" />
                <span>Active / ใช้งาน</span>
            </label>
        }
    </div>

    <h3 class="detail-section-heading">Usage / การใช้งาน</h3>
    <div class="form-grid">
        <label>
            <span>Sort Order / ลำดับ</span>
            <InputNumber class="input" @bind-Value="Model.SortOrder" />
        </label>

        <label class="span-2">
            <span>Description / หน้าและคำอธิบาย</span>
            <InputTextArea class="input textarea"
                           placeholder="Page / หน้า: Words, Search | Use / ใช้สำหรับ: คำศัพท์หลักและตัวอย่างสำหรับผู้เรียน"
                           @bind-Value="Model.Description" />
            <ValidationMessage For="@(() => Model.Description)" />
        </label>
    </div>

    <div class="actions">
        <button class="button primary" type="submit" disabled="@IsSaving">@SubmitText</button>
        <a class="button" href="@AdminRoutes.Categories.Index">Cancel / ยกเลิก</a>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public CategoryFormModel Model { get; set; } = new();

    [Parameter]
    public IReadOnlyDictionary<string, string[]> ValidationErrors { get; set; } =
        new Dictionary<string, string[]>();

    [Parameter]
    public bool IsSaving { get; set; }

    [Parameter]
    public bool ShowActiveToggle { get; set; }

    [Parameter]
    public string SubmitText { get; set; } = "Save";

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    private async Task SubmitAsync()
    {
        await OnValidSubmit.InvokeAsync();
    }
}
